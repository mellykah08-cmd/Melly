index 0000000..b21eee1
--- /dev/null
+++ b/src/lib/sofia-ops/worldStore.ts
@@ -0,0 +1,281 @@
+"use client";
+
+// Sofia Spatial OS — client world store.
+// Single place that merges the Event Fabric (OpenClaw runtime frames + external
+// ingress polled from /api/sofia-ops/events), derives the World State with the
+// deterministic reducer, keeps RAM-only snapshots for spatial replay, and
+// serves one immutable "view" to the scene and the HUD (useSyncExternalStore).
+
+import { useSyncExternalStore } from "react";
+import { getSofiaOpsEvents, subscribeSofiaOpsEvents } from "@/lib/sofia-ops/eventBus";
+import {
+  reduceWorld,
+  worldSignature,
+  type WorldAgentInput,
+  type WorldEvent,
+  type WorldState,
+} from "@/lib/sofia-ops/worldState";
+
+export type InspectTarget =
+  | { kind: "agent"; id: string }
+  | { kind: "zone"; id: string }
+  | { kind: "incident"; id: string }
+  | { kind: "project"; id: string };
+
+export type GatewayLinkState = "connected" | "connecting" | "reconnecting" | "disconnected";
+
+export type WorldSnapshot = { at: number; world: WorldState; signature: string };
+
+export type SofiaWorldView = {
+  world: WorldState;
+  live: WorldState;
+  replay: { active: boolean; index: number; total: number; at: number | null };
+  snapshots: { at: number; mode: WorldState["mode"] }[];
+  events: WorldEvent[];
+  agents: (WorldAgentInput & { sessionKey?: string | null; runId?: string | null; lastActivityAt?: number | null })[];
+  autoFollow: boolean;
+  glideRequest: number;
+  inspect: InspectTarget | null;
+  gateway: { state: GatewayLinkState; since: number };
+  fabric: { polling: boolean; lastPollOk: number | null; head: number };
+  version: number;
+};
+
+const MAX_SNAPSHOTS = 180;
+const MAX_EVENTS = 240;
+const AUTO_FOLLOW_KEY = "sofia-ops:auto-follow";
+
+const readAutoFollow = () => {
+  try {
+    return window.localStorage.getItem(AUTO_FOLLOW_KEY) !== "0";
+  } catch {
+    return true;
+  }
+};
+
+const emptyWorld = reduceWorld([], [], 0);
+
+const store = {
+  external: new Map<string, WorldEvent>(),
+  head: 0,
+  agents: [] as SofiaWorldView["agents"],
+  agentKey: "",
+  live: emptyWorld,
+  liveSignature: worldSignature(emptyWorld),
+  snapshots: [] as WorldSnapshot[],
+  replayIndex: null as number | null,
+  autoFollow: true,
+  glideRequest: 0,
+  inspect: null as InspectTarget | null,
+  gateway: { state: "connecting" as GatewayLinkState, since: 0 },
+  polling: false,
+  lastPollOk: null as number | null,
+  events: [] as WorldEvent[],
+  view: null as SofiaWorldView | null,
+  version: 0,
+  started: false,
+};
+
+const listeners = new Set<() => void>();
+
+const buildView = (): SofiaWorldView => {
+  const replaying = store.replayIndex !== null && store.snapshots[store.replayIndex];
+  const snapshot = replaying ? store.snapshots[store.replayIndex as number] : null;
+  return {
+    world: snapshot ? snapshot.world : store.live,
+    live: store.live,
+    replay: {
+      active: Boolean(snapshot),
+      index: store.replayIndex ?? store.snapshots.length - 1,
+      total: store.snapshots.length,
+      at: snapshot ? snapshot.at : null,
+    },
+    snapshots: store.snapshots.map((entry) => ({ at: entry.at, mode: entry.world.mode })),
+    events: store.events,
+    agents: store.agents,
+    autoFollow: store.autoFollow,
+    glideRequest: store.glideRequest,
+    inspect: store.inspect,
+    gateway: store.gateway,
+    fabric: { polling: store.polling, lastPollOk: store.lastPollOk, head: store.head },
+    version: store.version,
+  };
+};
+
+const emit = () => {
+  store.version += 1;
+  store.view = buildView();
+  if (typeof window !== "undefined") {
+    const holder = window as Window & { __SOFIA_WORLD?: SofiaWorldView };
+    holder.__SOFIA_WORLD = store.view;
+  }
+  listeners.forEach((listener) => listener());
+};
+
+const mergedEvents = (): WorldEvent[] => {
+  const byId = new Map<string, WorldEvent>();
+  for (const event of getSofiaOpsEvents()) byId.set(event.id, event as WorldEvent);
+  for (const event of store.external.values()) byId.set(event.id, event);
+  return [...byId.values()].sort((a, b) => b.ts - a.ts).slice(0, MAX_EVENTS);
+};
+
+// Recompute the live world. Only notifies (and snapshots) when something visible changed.
+const recompute = (force = false) => {
+  const now = Date.now();
+  const events = mergedEvents();
+  const live = reduceWorld(events, store.agents, now);
+  const signature = worldSignature(live);
+  const eventsChanged = events.length !== store.events.length || events[0]?.id !== store.events[0]?.id;
+  store.events = events;
+  const changed = signature !== store.liveSignature;
+  if (!changed && !force && !eventsChanged) return;
+  // Keep the live object identity stable unless something visible changed, so
+  // the scene does not re-plan paths for nothing.
+  if (changed || force) {
+    store.live = live;
+    store.liveSignature = signature;
+  }
+  if (changed) {
+    store.snapshots.push({ at: now, world: live, signature });
+    if (store.snapshots.length > MAX_SNAPSHOTS) {
+      store.snapshots.shift();
+      if (store.replayIndex !== null) store.replayIndex = Math.max(0, store.replayIndex - 1);
+    }
+  }
+  emit();
+};
+
+let pollTimer: number | null = null;
+let tickTimer: number | null = null;
+let recomputeQueued = false;
+
+const queueRecompute = () => {
+  if (recomputeQueued) return;
+  recomputeQueued = true;
+  window.setTimeout(() => {
+    recomputeQueued = false;
+    recompute();
+  }, 120);
+};
+
+const pollOnce = async () => {
+  if (typeof document !== "undefined" && document.visibilityState === "hidden") return;
+  try {
+    const response = await fetch("/api/sofia-ops/events?after=" + store.head, { cache: "no-store", credentials: "same-origin" });
+    if (!response.ok) return;
+    const data = (await response.json()) as { head?: number; events?: WorldEvent[] };
+    store.lastPollOk = Date.now();
+    if (typeof data.head === "number" && data.head < store.head) {
+      // Server restarted (RAM store reset): resync from scratch.
+      store.external.clear();
+      store.head = 0;
+    }
+    let added = 0;
+    for (const event of data.events ?? []) {
+      if (!store.external.has(event.id)) added += 1;
+      store.external.set(event.id, event);
+    }
+    if (store.external.size > MAX_EVENTS) {
+      const keep = [...store.external.values()].sort((a, b) => b.ts - a.ts).slice(0, MAX_EVENTS);
+      store.external = new Map(keep.map((event) => [event.id, event]));
+    }
+    if (typeof data.head === "number") store.head = data.head;
+    if (added) recompute();
+  } catch {
+    // Offline or gateway hiccup: keep the last world, try again later.
+  }
+};
+
+const schedulePoll = () => {
+  // Adaptive cadence: fast while the world is hot, slow when quiet.
+  const newest = store.events[0]?.ts ?? 0;
+  const hot = Date.now() - newest < 120000 || store.live.mode !== "nominal";
+  pollTimer = window.setTimeout(async () => {
+    await pollOnce();
+    schedulePoll();
+  }, hot ? 1500 : 4000);
+};
+
+const start = () => {
+  if (store.started || typeof window === "undefined") return;
+  store.started = true;
+  store.autoFollow = readAutoFollow();
+  store.polling = true;
+  subscribeSofiaOpsEvents(queueRecompute);
+  void pollOnce().then(() => recompute(true));
+  schedulePoll();
+  // Time-window transitions (convocando -> em andamento, recovery fade, expiry).
+  tickTimer = window.setInterval(() => recompute(), 2000);
+  document.addEventListener("visibilitychange", () => {
+    if (document.visibilityState === "visible") {
+      void pollOnce();
+      recompute();
+    }
+  });
+};
+
+export const sofiaWorld = {
+  subscribe(listener: () => void) {
+    start();
+    listeners.add(listener);
+    return () => {
+      listeners.delete(listener);
+    };
+  },
+  getView(): SofiaWorldView {
+    if (!store.view) store.view = buildView();
+    return store.view;
+  },
+  setAgents(agents: SofiaWorldView["agents"]) {
+    const key = agents.map((agent) => agent.id + ":" + (agent.status ?? "") + ":" + (agent.runId ?? "")).join("|");
+    store.agents = agents;
+    if (key === store.agentKey) return;
+    store.agentKey = key;
+    recompute(true);
+  },
+  setGateway(state: GatewayLinkState) {
+    if (store.gateway.state === state) return;
+    store.gateway = { state, since: Date.now() };
+    emit();
+  },
+  setReplayIndex(index: number | null) {
+    const next = index === null || store.snapshots.length === 0 ? null : Math.max(0, Math.min(store.snapshots.length - 1, index));
+    // The last snapshot is "now": selecting it means LIVE.
+    store.replayIndex = next !== null && next >= store.snapshots.length - 1 ? null : next;
+    emit();
+  },
+  setAutoFollow(value: boolean) {
+    store.autoFollow = value;
+    try {
+      window.localStorage.setItem(AUTO_FOLLOW_KEY, value ? "1" : "0");
+    } catch {}
+    emit();
+  },
+  // One-shot camera glide to the current focus (used when auto-follow is OFF).
+  glideToFocus() {
+    store.glideRequest += 1;
+    emit();
+  },
+  inspect(target: InspectTarget | null) {
+    store.inspect = target;
+    emit();
+  },
+  refresh() {
+    void pollOnce();
+  },
+  stopForTests() {
+    if (pollTimer !== null) window.clearTimeout(pollTimer);
+    if (tickTimer !== null) window.clearInterval(tickTimer);
+  },
+};
+
+const serverView = (() => {
+  let cached: SofiaWorldView | null = null;
+  return () => {
+    if (!cached) cached = buildView();
+    return cached;
+  };
+})();
+
+export const useSofiaWorld = (): SofiaWorldView =>
+  useSyncExternalStore(sofiaWorld.subscribe, sofiaWorld.getView, serverView);
