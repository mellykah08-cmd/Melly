+  const runtimeSeen = new Set<string>();
+  for (const event of newestFirst) {
+    if (now - event.ts > RUNTIME_MS) break;
+    const info = classified.get(event.id)!;
+    if (!info.kind.startsWith("agent.") && info.kind !== "approval") continue;
+    const id = event.agentId ?? "";
+    if (!id || !agents[id] || runtimeSeen.has(id)) continue;
+    runtimeSeen.add(id);
+    if (claimed.has(id) || info.kind === "agent.end") continue;
+    if (info.kind === "agent.error") claim(id, "incident", "desk", event, "erro no run " + (event.runId ?? ""), null);
+    else if (info.kind === "agent.tool") claim(id, "working", "desk", event, event.summary, null);
+    else if (info.kind === "approval") claim(id, "thinking", "desk", event, "aguardando aprovação", null);
+    else claim(id, "thinking", "desk", event, "run ativo", null);
+  }
