@@ -0,0 +1,100 @@
+import { describe, expect, it } from "vitest";
+import floor1 from "../fixtures/sofia-floor1-furniture.json";
+import { astar, buildNavGrid, getMeetingSeatLocations } from "@/features/retro-office/core/navigation";
+import { materializeDefaults } from "@/features/retro-office/core/furnitureDefaults";
+import type { FurnitureItem } from "@/features/retro-office/core/types";
+import {
+  FLOOR_ZONES,
+  resolveSofiaTargets,
+  resolveSpatialLayout,
+} from "@/features/sofia-ops/spatialTargets";
+import type { SofiaFloorId, ZoneId } from "@/lib/sofia-ops/worldState";
+
+const ZONE_AGENT: Record<ZoneId, string> = {
+  infra: "railway-ops",
+  audit: "n8n-reviewer",
+  qa: "supervisor",
+  shadow: "sofia-monitor",
+  warroom: "main",
+  desk: "desk-agent",
+  intel: "intel-agent",
+};
+
+const resolveFloor = (items: FurnitureItem[], floorId: SofiaFloorId, zones: ZoneId[]) => {
+  const { warSeats: seats, anchors, stands, relocated } = resolveSpatialLayout(items, floorId, getMeetingSeatLocations(items));
+  const zoneByAgentId: Record<string, ZoneId> = {};
+  for (const zone of zones) zoneByAgentId[ZONE_AGENT[zone]] = zone;
+  zoneByAgentId.supervisor2 = "warroom";
+  zoneByAgentId.main2 = "warroom";
+  return { seats, anchors, relocated, set: resolveSofiaTargets(zoneByAgentId, anchors, seats, stands) };
+};
+
+describe("Sofia spatial targets", () => {
+  const items = floor1 as FurnitureItem[];
+  const grid = buildNavGrid(items);
+  // Agents start around the Sofia first-floor desks.
+  const starts = [
+    { x: 650, y: 230 },
+    { x: 800, y: 480 },
+    { x: 1080, y: 440 },
+  ];
+
+  it("first floor: every station and War Room seat is reachable by A*", () => {
+    const { seats, anchors, relocated, set } = resolveFloor(items, "openclaw-ground", ["infra", "audit", "qa", "shadow", "warroom"]);
+    // Sofia first floor: the QA lab and its round table are sealed, so audit, QA
+    // and the War Room use semantic fallbacks; infra and shadow keep their rooms.
+    expect(relocated.sort()).toEqual(["audit", "qa", "warroom"]);
+    // No two zones share the same station.
+    const keys = (["infra", "audit", "qa", "shadow", "warroom"] as const).map((zone) => JSON.stringify(anchors[zone]));
+    expect(new Set(keys).size).toBe(keys.length);
+    expect(seats.length).toBeGreaterThanOrEqual(3);
+    expect(anchors.infra && anchors.infra.x < 340 && anchors.infra.y < 330).toBeTruthy();
+    for (const [agentId, target] of Object.entries(set.targets)) {
+      for (const start of starts) {
+        const path = astar(start.x, start.y, target.x, target.y, grid);
+        expect(path.length, agentId + " from " + JSON.stringify(start) + " to " + JSON.stringify(target)).toBeGreaterThan(0);
+        const last = path[path.length - 1];
+        expect(Math.hypot(last.x - target.x, last.y - target.y), agentId + " ends near target").toBeLessThan(60);
+      }
+    }
+    expect(set.targets.main.pose).toBe("sit");
+    expect(set.targets["railway-ops"].pose).toBe("stand");
+  });
+
+  it("first floor: Railway Ops reaches the server room through its door", () => {
+    const { set } = resolveFloor(items, "openclaw-ground", ["infra"]);
+    const target = set.targets["railway-ops"];
+    // Server room walls: x 30..330, y 60..300 (door at x 150..190, y 300).
+    expect(target.x).toBeGreaterThan(30);
+    expect(target.x).toBeLessThan(330);
+    expect(target.y).toBeLessThanOrEqual(310);
+    const path = astar(650, 230, target.x, target.y, grid);
+    expect(path.length).toBeGreaterThan(0);
+    // The route really crosses the door gap instead of stopping outside.
+    expect(path.some((point) => point.y < 300 && point.x < 330)).toBe(true);
+  });
+
+  const presets: [string, SofiaFloorId][] = [
+    ["audit", "audit-second"],
+    ["dev", "dev-third"],
+    ["infra", "infra-fourth"],
+    ["intel", "intel-fifth"],
+    ["command", "command-sixth"],
+  ];
+  for (const [preset, floorId] of presets) {
+    it(floorId + ": its own zones resolve to reachable places", () => {
+      const floorItems = materializeDefaults(preset as Parameters<typeof materializeDefaults>[0]);
+      const floorGrid = buildNavGrid(floorItems);
+      const { set } = resolveFloor(floorItems, floorId, FLOOR_ZONES[floorId]);
+      for (const [agentId, target] of Object.entries(set.targets)) {
+        const path = astar(700, 320, target.x, target.y, floorGrid);
+        expect(path.length, floorId + " " + agentId + " -> " + JSON.stringify(target)).toBeGreaterThan(0);
+      }
+      // Zones without a physical place on this floor fall back to desk work.
+      for (const zone of FLOOR_ZONES[floorId]) {
+        const agentId = ZONE_AGENT[zone];
+        expect(Boolean(set.targets[agentId]) || Boolean(set.deskHolds[agentId]), floorId + " " + zone).toBe(true);
+      }
+    });
+  }
+});
diff --git a/tests/unit/sofiaWorldState.test.ts b/tests/unit/sofiaWorldState.test.ts
new file mode 100644
index 0000000..559d829
--- /dev/null
+++ b/tests/unit/sofiaWorldState.test.ts
@@ -0,0 +1,134 @@
+import { describe, expect, it } from "vitest";
+import { classifyEvent, reduceWorld, worldSignature, type WorldEvent } from "@/lib/sofia-ops/worldState";
+
+const AGENTS = ["main", "supervisor", "sofia-monitor", "n8n-reviewer", "railway-ops"].map((id) => ({ id, status: "idle" }));
+const T0 = 1_800_000_000_000;
+
+let counter = 0;
+const ev = (partial: Partial<WorldEvent> & { type: string }, at: number): WorldEvent => ({
+  id: "e" + ++counter,
+  ts: T0 + at,
+  source: "system",
+  severity: "info",
+  summary: partial.type,
+  ...partial,
+});
+
+describe("Sofia world state reducer", () => {
+  it("routes a Railway deploy to Railway Ops in the Infra zone", () => {
+    const world = reduceWorld([ev({ type: "railway.deploy.started", source: "railway" }, 0)], AGENTS, T0 + 1000);
+    expect(world.agents["railway-ops"]).toMatchObject({ state: "working", zone: "infra", floorId: "infra-fourth" });
+    expect(world.zoneByAgentId["railway-ops"]).toBe("infra");
+    expect(world.zones.infra.level).toBe("active");
+    expect(world.mode).toBe("deploy");
+    expect(world.focus).toMatchObject({ zone: "infra", agentId: "railway-ops" });
+  });
+
+  it("sends n8n audit/failure to the n8n Reviewer in the Audit Lab", () => {
+    const world = reduceWorld([ev({ type: "n8n.workflow.failed", source: "n8n", severity: "warning" }, 0)], AGENTS, T0 + 1000);
+    expect(world.agents["n8n-reviewer"]).toMatchObject({ state: "auditing", zone: "audit" });
+    expect(world.incident).toBeNull();
+    expect(world.mode).toBe("audit");
+  });
+
+  it("builds a spatial Shadow Twin pair and parses the comparison", () => {
+    const events = [
+      ev({ type: "shadow.candidate", source: "openclaw", correlationId: "c1" }, 0),
+      ev({ type: "shadow.human", source: "whatsapp", correlationId: "c1" }, 2000),
+      ev({ type: "shadow.compare", source: "openclaw", correlationId: "c1", summary: "Comparação: 82% equivalente", payloadText: '{"score":0.82,"match":true}' }, 4000),
+    ];
+    const world = reduceWorld(events, AGENTS, T0 + 5000);
+    expect(world.shadow.active).toBe(true);
+    expect(world.shadow.candidate?.id).toBe(events[0].id);
+    expect(world.shadow.human?.id).toBe(events[1].id);
+    expect(world.shadow.compare).toMatchObject({ score: 82, verdict: "match" });
+    expect(world.agents["sofia-monitor"]).toMatchObject({ state: "shadow", zone: "shadow" });
+    expect(world.mode).toBe("shadow");
+  });
+
+  it("opens the War Room on a critical event and convokes the responsible agents", () => {
+    const failed = ev({ type: "railway.deploy.failed", source: "railway", severity: "critical" }, 0);
+    const convoking = reduceWorld([failed], AGENTS, T0 + 3000);
+    expect(convoking.incident).toMatchObject({ state: "convocando", ownerZone: "infra" });
+    expect(convoking.incident?.responsible).toEqual(["railway-ops", "supervisor", "main"]);
+    for (const id of ["railway-ops", "supervisor", "main"]) {
+      expect(convoking.agents[id].state).toBe("meeting");
+      expect(convoking.zoneByAgentId[id]).toBe("warroom");
+    }
+    expect(convoking.mode).toBe("incident");
+    expect(convoking.alertLevel).toBe(1);
+    expect(convoking.zones.warroom.level).toBe("alert");
+    expect(convoking.focus?.zone).toBe("warroom");
+    const running = reduceWorld([failed], AGENTS, T0 + 30000);
+    expect(running.incident?.state).toBe("em andamento");
+  });
+
+  it("recovers: releases agents, fades the alert, then clears the incident", () => {
+    const failed = ev({ type: "railway.deploy.failed", source: "railway", severity: "critical" }, 0);
+    const resolved = ev({ type: "incident.resolved", source: "railway", severity: "success" }, 60000);
+    const recovering = reduceWorld([failed, resolved], AGENTS, T0 + 60000 + 9000);
+    expect(recovering.incident?.state).toBe("recuperando");
+    expect(recovering.mode).toBe("recovery");
+    expect(recovering.alertLevel).toBeGreaterThan(0);
+    expect(recovering.alertLevel).toBeLessThan(1);
+    expect(Object.values(recovering.zoneByAgentId)).not.toContain("warroom");
+    expect(recovering.zones.warroom.level).toBe("recovering");
+    const later = reduceWorld([failed, resolved], AGENTS, T0 + 60000 + 60000);
+    expect(later.incident).toBeNull();
+    expect(later.alertLevel).toBe(0);
+  });
+
+  it("substitutes an unavailable owner with a free agent", () => {
+    const agents = AGENTS.filter((agent) => agent.id !== "railway-ops");
+    const world = reduceWorld([ev({ type: "railway.deploy.started", source: "railway" }, 0)], agents, T0 + 1000);
+    const substitute = Object.entries(world.agents).find(([, agent]) => agent.zone === "infra");
+    expect(substitute?.[1].substituteFor).toBe("railway-ops");
+    const errored = reduceWorld(
+      [ev({ type: "n8n.audit.review", source: "n8n" }, 0)],
+      AGENTS.map((agent) => (agent.id === "n8n-reviewer" ? { ...agent, status: "error" } : agent)),
+      T0 + 1000,
+    );
+    const auditor = Object.entries(errored.agents).find(([, agent]) => agent.zone === "audit");
+    expect(auditor?.[0]).not.toBe("n8n-reviewer");
+    expect(auditor?.[1].substituteFor).toBe("n8n-reviewer");
+  });
+
+  it("maps real OpenClaw runtime runs to thinking/working and back to idle", () => {
+    const start = ev({ type: "agent.run.start", source: "openclaw", agentId: "main", runId: "r1" }, 0);
+    const tool = ev({ type: "agent.tool", source: "openclaw", agentId: "main", runId: "r1", summary: "ferramenta: exec" }, 1000);
+    const end = ev({ type: "agent.run.end", source: "openclaw", agentId: "main", runId: "r1", severity: "success" }, 5000);
+    expect(reduceWorld([start], AGENTS, T0 + 500).agents.main.state).toBe("thinking");
+    expect(reduceWorld([start, tool], AGENTS, T0 + 1500).agents.main.state).toBe("working");
+    expect(reduceWorld([start, tool, end], AGENTS, T0 + 6000).agents.main.state).toBe("idle");
+  });
+
+  it("never opens the War Room from runtime chat errors", () => {
+    const world = reduceWorld([ev({ type: "chat.error", source: "openclaw", agentId: "main", severity: "warning", summary: "fatal error timeout" }, 0)], AGENTS, T0 + 1000);
+    expect(world.incident).toBeNull();
+    expect(world.agents.main.state).toBe("incident");
+  });
+
+  it("creates a project tower for events carrying project", () => {
+    const world = reduceWorld([ev({ type: "railway.deploy.started", source: "railway", project: "Clínica Norte" }, 0)], AGENTS, T0 + 1000);
+    expect(world.projects.map((project) => project.id)).toEqual(["sofia", "clinica-norte"]);
+    expect(world.projects[1]).toMatchObject({ recentCount: 1, home: false });
+  });
+
+  it("is deterministic regardless of input order", () => {
+    const events = [
+      ev({ type: "railway.deploy.started", source: "railway" }, 0),
+      ev({ type: "audit.started", source: "n8n" }, 1000),
+      ev({ type: "shadow.candidate", source: "openclaw" }, 2000),
+      ev({ type: "incident.opened", severity: "critical" }, 3000),
+    ];
+    const a = reduceWorld(events, AGENTS, T0 + 4000);
+    const b = reduceWorld(events.slice().reverse(), AGENTS.slice().reverse(), T0 + 4000);
+    expect(worldSignature(a)).toBe(worldSignature(b));
+  });
+
+  it("classifies events into physical zones and floors", () => {
+    expect(classifyEvent(ev({ type: "railway.deploy.failed", source: "railway", severity: "critical" }, 0))).toMatchObject({ kind: "deploy.failed", zone: "infra", critical: true });
+    expect(classifyEvent(ev({ type: "github.ci.test" }, 0))).toMatchObject({ kind: "qa", floorId: "dev-third" });
+    expect(classifyEvent(ev({ type: "incident.resolved", severity: "success" }, 0)).kind).toBe("recovery");
+  });
+});
