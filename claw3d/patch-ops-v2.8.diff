diff --git a/src/app/api/sofia-ops/harness/route.ts b/src/app/api/sofia-ops/harness/route.ts
new file mode 100644
index 0000000..28fcccd
--- /dev/null
+++ b/src/app/api/sofia-ops/harness/route.ts
@@ -0,0 +1,108 @@
+import { NextRequest, NextResponse } from "next/server";
+import {
+  clearSyntheticSofiaOpsServerEvents,
+  listSofiaOpsServerEvents,
+  pushSofiaOpsServerEvent,
+} from "@/lib/sofia-ops/serverEventStore";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+// Event Harness: synthetic events enter the SAME Event Fabric as real ingress
+// (pushSofiaOpsServerEvent), flagged synthetic so the UI never reports them as
+// real integrations. Protected by the Studio access gate (cookie) plus a custom
+// header (forces a CORS preflight, so other sites cannot fire it). Nothing here
+// talks to WhatsApp, n8n or Railway. Disable with SOFIA_OPS_HARNESS=0.
+
+type Template = { type: string; source: string; severity: "info" | "success" | "warning" | "critical"; summary: string; correlationId?: string; payload?: unknown };
+
+const TEMPLATES: Record<string, (ctx: { project: string | null; correlationId: string; incidentSource: string }) => Template> = {
+  "deploy.started": () => ({ type: "railway.deploy.started", source: "railway", severity: "info", summary: "Deploy iniciado no Railway" }),
+  "deploy.success": () => ({ type: "railway.deploy.success", source: "railway", severity: "success", summary: "Deploy concluído com sucesso" }),
+  "deploy.failed": () => ({ type: "railway.deploy.failed", source: "railway", severity: "critical", summary: "Deploy falhou: healthcheck sem resposta", payload: { service: "sofia-api", exitCode: 1, healthcheck: "/healthz timeout" } }),
+  "n8n.failed": () => ({ type: "n8n.workflow.failed", source: "n8n", severity: "warning", summary: "Workflow n8n falhou no nó HTTP Request", payload: { workflow: "sofia-agenda", node: "HTTP Request", error: "502" } }),
+  "audit.started": () => ({ type: "audit.started", source: "n8n", severity: "info", summary: "Auditoria de fluxo iniciada" }),
+  "shadow.candidate": (ctx) => ({ type: "shadow.candidate", source: "openclaw", severity: "info", summary: "Sofia gerou resposta candidata (não enviada)", correlationId: ctx.correlationId }),
+  "shadow.human": (ctx) => ({ type: "shadow.human", source: "whatsapp", severity: "info", summary: "Resposta humana registrada para comparação", correlationId: ctx.correlationId }),
+  "shadow.compare": (ctx) => ({ type: "shadow.compare", source: "openclaw", severity: "info", summary: "Comparação: 82% equivalente", correlationId: ctx.correlationId, payload: { score: 0.82, match: true } }),
+  incident: () => ({ type: "incident.opened", source: "system", severity: "critical", summary: "Incidente crítico: latência alta no atendimento" }),
+  recovery: (ctx) => ({ type: "incident.resolved", source: ctx.incidentSource, severity: "success", summary: "Serviço recuperado, métricas normalizadas" }),
+};
+
+const SCENARIO: { at: number; kind: string }[] = [
+  { at: 0, kind: "deploy.started" },
+  { at: 9000, kind: "audit.started" },
+  { at: 18000, kind: "shadow.candidate" },
+  { at: 23000, kind: "shadow.human" },
+  { at: 28000, kind: "shadow.compare" },
+  { at: 38000, kind: "deploy.failed" },
+  { at: 70000, kind: "recovery" },
+];
+
+type HarnessState = { timers: ReturnType<typeof setTimeout>[]; runningUntil: number; shadow?: { id: string; ts: number } };
+const root = globalThis as typeof globalThis & { __sofiaOpsHarness?: HarnessState };
+const harness: HarnessState = root.__sofiaOpsHarness ?? { timers: [], runningUntil: 0 };
+root.__sofiaOpsHarness = harness;
+
+const latestIncidentSource = () =>
+  listSofiaOpsServerEvents().find((event) => event.severity === "critical")?.source ?? "system";
+
+const fire = (kind: string, project: string | null, correlationId: string) => {
+  const template = TEMPLATES[kind];
+  if (!template) return null;
+  const event = template({ project, correlationId, incidentSource: latestIncidentSource() });
+  return pushSofiaOpsServerEvent({ ...event, summary: "[SIM] " + event.summary, project: project ?? undefined }, { synthetic: true });
+};
+
+const cancelScenario = () => {
+  for (const timer of harness.timers) clearTimeout(timer);
+  harness.timers = [];
+  harness.runningUntil = 0;
+};
+
+export async function GET() {
+  if (process.env.SOFIA_OPS_HARNESS === "0") return NextResponse.json({ enabled: false }, { status: 404 });
+  return NextResponse.json(
+    { enabled: true, kinds: Object.keys(TEMPLATES), scenario: SCENARIO, running: harness.runningUntil > Date.now(), runningUntil: harness.runningUntil },
+    { headers: { "Cache-Control": "no-store" } },
+  );
+}
+
+export async function POST(request: NextRequest) {
+  if (process.env.SOFIA_OPS_HARNESS === "0") return NextResponse.json({ error: "harness_disabled" }, { status: 404 });
+  if (request.headers.get("x-sofia-harness") !== "1") return NextResponse.json({ error: "missing_header" }, { status: 400 });
+  let body: { kind?: unknown; scenario?: unknown; project?: unknown } = {};
+  try {
+    const raw = await request.text();
+    if (raw.length > 4000) return NextResponse.json({ error: "payload_too_large" }, { status: 413 });
+    body = raw ? JSON.parse(raw) : {};
+  } catch {
+    return NextResponse.json({ error: "invalid_json" }, { status: 400 });
+  }
+  const project = typeof body.project === "string" && body.project.trim() ? body.project.trim().slice(0, 40) : null;
+  // Single shadow.* fires within 3 minutes share one correlation, so candidate,
+  // human and compare land on the same Shadow Twin pair.
+  if (!harness.shadow || Date.now() - harness.shadow.ts > 180000) harness.shadow = { id: "sim-" + Date.now().toString(36), ts: Date.now() };
+  harness.shadow.ts = Date.now();
+  const correlationId = harness.shadow.id;
+
+  if (body.scenario === "reset") {
+    cancelScenario();
+    return NextResponse.json({ ok: true, removed: clearSyntheticSofiaOpsServerEvents() });
+  }
+  if (body.scenario === "full") {
+    cancelScenario();
+    const total = SCENARIO[SCENARIO.length - 1].at;
+    harness.runningUntil = Date.now() + total;
+    for (const step of SCENARIO) {
+      const timer = setTimeout(() => fire(step.kind, project, correlationId), step.at);
+      if (typeof timer === "object" && timer && "unref" in timer) (timer as { unref: () => void }).unref();
+      harness.timers.push(timer);
+    }
+    return NextResponse.json({ ok: true, scenario: "full", steps: SCENARIO.length, durationMs: total }, { status: 202 });
+  }
+  const kind = typeof body.kind === "string" ? body.kind : "";
+  const event = fire(kind, project, correlationId);
+  if (!event) return NextResponse.json({ error: "unknown_kind", kinds: Object.keys(TEMPLATES) }, { status: 400 });
+  return NextResponse.json({ ok: true, event }, { status: 202 });
+}
