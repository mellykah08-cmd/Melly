+    const recoveredLongAgo = recoveryEvent && now - recoveryEvent.ts > RECOVERY_MS;
+    if (!expired && !recoveredLongAgo) {
+      const ownerInfo = classified.get(incidentEvent.id)!;
+      const ownerZone: ZoneId = ownerInfo.zone === "warroom" ? "warroom" : ownerInfo.zone;
+      const responsible: string[] = [];
+      if (!recoveryEvent) {
+        for (const preferred of [ZONE_OWNER[ownerZone], "supervisor", "main"]) {
+          const pickResult = resolveAgent(preferred);
+          if (!pickResult || responsible.includes(pickResult.id)) continue;
+          responsible.push(pickResult.id);
+          claim(pickResult.id, "meeting", "warroom", incidentEvent, "War Room: " + incidentEvent.type, pickResult.substituteFor);
+        }
+      }
