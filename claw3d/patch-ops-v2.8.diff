+// Sofia Spatial OS — World State.
+//
+// One deterministic reducer: (events, agents, now) -> WorldState.
+// Every spatial behaviour in the office (who walks where, which room lights
+// up, War Room, Shadow Twin, project towers, camera focus) is read from this
+// object. No component keeps its own copy of these rules.
+//
+// OpenClaw stays the source of truth for agents/sessions/runs: agent ids,
+// names and live status come from the gateway; this module only decides how
+// that state and the Event Fabric are represented in space.
+
+export type SofiaSeverity = "info" | "success" | "warning" | "critical";
+
+export type WorldEvent = {
+  id: string;
+  ts: number;
+  type: string;
+  source: string;
+  severity: SofiaSeverity;
+  summary: string;
+  payloadText?: string;
+  floorHint?: string | null;
+  project?: string | null;
+  agentId?: string | null;
+  correlationId?: string | null;
+  runId?: string | null;
+  synthetic?: boolean;
+  seq?: number;
+};
+
+export type SpatialState =
+  | "idle"
+  | "working"
+  | "thinking"
+  | "auditing"
+  | "meeting"
+  | "incident"
+  | "shadow";
+
+// Physical zones. Each one maps to a real place in the office scene.
+export type ZoneId = "desk" | "infra" | "audit" | "qa" | "shadow" | "warroom" | "intel";
+
+export type SofiaFloorId =
+  | "openclaw-ground"
+  | "audit-second"
+  | "dev-third"
+  | "infra-fourth"
+  | "intel-fifth"
+  | "command-sixth";
+
+export type WorldMode = "nominal" | "working" | "deploy" | "audit" | "shadow" | "incident" | "recovery";
+
+export type EventKind =
+  | "deploy"
+  | "deploy.failed"
+  | "audit"
+  | "n8n.failed"
+  | "qa"
+  | "intel"
+  | "shadow.candidate"
+  | "shadow.human"
+  | "shadow.compare"
+  | "incident"
+  | "recovery"
+  | "agent.start"
+  | "agent.tool"
+  | "agent.end"
+  | "agent.error"
+  | "approval"
+  | "generic";
+
+export type WorldAgentInput = {
+  id: string;
+  name?: string;
+  status?: string;
+};
+
+export type AgentWorldState = {
+  state: SpatialState;
+  zone: ZoneId | null;
+  floorId: SofiaFloorId;
+  reason: string;
+  eventId: string | null;
+  since: number;
+  substituteFor: string | null;
+  available: boolean;
+};
+
+export type ZoneWorldState = {
+  level: "idle" | "active" | "alert" | "recovering";
+  owner: string | null;
+  eventId: string | null;
+  label: string;
+  since: number | null;
+  count: number;
+};
+
+export type IncidentWorldState = {
+  id: string;
+  type: string;
+  source: string;
+  project: string;
+  summary: string;
+  openedAt: number;
+  state: "convocando" | "em andamento" | "recuperando";
+  responsible: string[];
+  ownerZone: ZoneId;
+  timeline: { id: string; ts: number; type: string; severity: SofiaSeverity; summary: string }[];
+  evidence: string[];
+  resolvedAt: number | null;
+  synthetic: boolean;
+};
+
+export type ShadowItem = { id: string; ts: number; summary: string; synthetic: boolean };
+
+export type ShadowWorldState = {
+  active: boolean;
+  correlationId: string | null;
+  candidate: ShadowItem | null;
+  human: ShadowItem | null;
+  compare: (ShadowItem & { verdict: "match" | "diverge" | "unknown"; score: number | null }) | null;
+  counts: { candidate: number; human: number; compare: number };
+};
+
+export type ProjectWorldState = {
+  id: string;
+  label: string;
+  health: number;
+  lastTs: number;
+  eventCount: number;
+  recentCount: number;
+  incident: boolean;
+  lastSummary: string;
+  sources: string[];
+  home: boolean;
+};
+
+export type WorldFocus = {
+  zone: ZoneId;
+  floorId: SofiaFloorId;
+  agentId: string | null;
+  eventId: string;
+  reason: string;
+  priority: number;
+};
+
+export type WorldState = {
+  at: number;
+  mode: WorldMode;
+  alertLevel: number;
+  focus: WorldFocus | null;
+  agents: Record<string, AgentWorldState>;
+  zoneByAgentId: Record<string, ZoneId>;
+  zones: Record<ZoneId, ZoneWorldState>;
+  incident: IncidentWorldState | null;
+  shadow: ShadowWorldState;
+  projects: ProjectWorldState[];
+  floorActivity: Record<SofiaFloorId, { recent: number; hot: boolean }>;
+  eventCount: number;
+  syntheticActive: boolean;
+};
+
+export const ZONE_FLOOR: Record<ZoneId, SofiaFloorId> = {
+  desk: "openclaw-ground",
+  shadow: "openclaw-ground",
+  audit: "audit-second",
+  qa: "dev-third",
+  infra: "infra-fourth",
+  intel: "intel-fifth",
+  warroom: "command-sixth",
+};
+
+export const ZONE_LABEL: Record<ZoneId, string> = {
+  desk: "Operação",
+  shadow: "Estação Shadow",
+  audit: "Audit Lab",
+  qa: "QA Lab",
+  infra: "Infra",
+  intel: "Inteligência",
+  warroom: "War Room",
+};
+
+export const FLOOR_LABEL: Record<SofiaFloorId, string> = {
+  "openclaw-ground": "Operação",
+  "audit-second": "Auditoria",
+  "dev-third": "Dev & QA",
+  "infra-fourth": "Infra",
+  "intel-fifth": "Inteligência",
+  "command-sixth": "Command",
+};
+
+export const STATE_LABEL: Record<SpatialState, string> = {
+  idle: "livre",
+  working: "trabalhando",
+  thinking: "pensando",
+  auditing: "auditando",
+  meeting: "war room",
+  incident: "incidente",
+  shadow: "shadow",
+};
+
+// Real Sofia gateway agent ids. Unknown/offline owners are substituted.
+export const ZONE_OWNER: Record<ZoneId, string> = {
+  infra: "railway-ops",
+  audit: "n8n-reviewer",
+  qa: "supervisor",
+  shadow: "sofia-monitor",
+  intel: "main",
+  desk: "main",
+  warroom: "supervisor",
+};
+
+export const HOME_PROJECT = "sofia";
+
+const ACTIVITY_MS = 90_000;
+const RUNTIME_MS = 90_000;
+const FOCUS_MS = 60_000;
+const MODE_MS = 60_000;
+const CONVOCATION_MS = 15_000;
+const RECOVERY_MS = 45_000;
+const INCIDENT_TIMEOUT_MS = 10 * 60_000;
+const SHADOW_MS = 3 * 60_000;
+const RECENT_MS = 5 * 60_000;
+const HOT_MS = 60_000;
+
+const ZONES: ZoneId[] = ["desk", "infra", "audit", "qa", "shadow", "warroom", "intel"];
+const FLOORS: SofiaFloorId[] = ["openclaw-ground", "audit-second", "dev-third", "infra-fourth", "intel-fifth", "command-sixth"];
+
+const lower = (value: unknown) => (typeof value === "string" ? value.toLowerCase() : "");
+const textOf = (event: WorldEvent) => (event.type + " " + event.summary).toLowerCase();
+
+export const slugProject = (value: string | null | undefined) => {
+  const raw = lower(value).normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
+  if (!raw) return HOME_PROJECT;
+  const slug = raw.replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 40);
+  return slug || HOME_PROJECT;
+};
+
+export type ClassifiedEvent = {
+  kind: EventKind;
+  zone: ZoneId;
+  floorId: SofiaFloorId;
+  critical: boolean;
+};
+
+export const classifyEvent = (event: WorldEvent): ClassifiedEvent => {
+  const type = lower(event.type);
+  const text = textOf(event);
+  const source = lower(event.source);
+  const pick = (kind: EventKind, zone: ZoneId, critical = false): ClassifiedEvent => ({
+    kind,
+    zone,
+    floorId: ZONE_FLOOR[zone],
+    critical,
+  });
+
+  if (type.startsWith("agent.run.start") || type === "agent.assistant") return pick("agent.start", "desk");
+  if (type.startsWith("agent.tool")) return pick("agent.tool", "desk");
+  if (type.startsWith("agent.run.end") || type === "chat.final") return pick("agent.end", "desk");
+  if (type.startsWith("agent.run.error") || type === "chat.error") return pick("agent.error", "desk");
+  if (type.startsWith("approval.") || type.startsWith("exec.approval")) return pick("approval", "desk");
+
+  if (type.startsWith("shadow.candidate") || type.startsWith("shadow_candidate")) return pick("shadow.candidate", "shadow");
+  if (type.startsWith("shadow.human") || type.startsWith("shadow_human")) return pick("shadow.human", "shadow");
+  if (type.startsWith("shadow.compare") || type.startsWith("shadow_compare")) return pick("shadow.compare", "shadow");
+
+  if (/(recover|resolved|restored|mitigated|healthy|incident\.closed)/.test(type)) return pick("recovery", "warroom");
+
+  const failed = /(fail|error|crash|fatal|down|timeout)/.test(type);
+  const deployish = /(deploy|railway|build|release|service|infra)/.test(type) || source === "railway";
+  const auditish = /(audit|review|n8n|workflow)/.test(type) || source === "n8n";
+
+  if (deployish && failed) return pick("deploy.failed", "infra", true);
+  if (auditish && failed) return pick("n8n.failed", "audit", event.severity === "critical");
+  if (type.includes("incident") || event.severity === "critical") {
+    const zone: ZoneId = deployish ? "infra" : auditish ? "audit" : source === "whatsapp" ? "shadow" : "warroom";
+    return pick("incident", zone, true);
+  }
+  if (deployish) return pick("deploy", "infra");
+  if (auditish) return pick("audit", "audit");
+  if (/(test|qa|regress|lint|ci\.|github|pull|commit)/.test(type) || source === "github") return pick("qa", "qa");
+  if (/(analytic|metric|insight|report|compare|pattern)/.test(text)) return pick("intel", "intel");
+  if (source === "whatsapp") return pick("generic", "desk");
+  return pick("generic", "desk");
+};
+
+const ZONE_STATE: Record<ZoneId, SpatialState> = {
+  desk: "working",
+  infra: "working",
+  audit: "auditing",
+  qa: "auditing",
+  shadow: "shadow",
+  warroom: "meeting",
+  intel: "working",
+};
+
+const parseScore = (event: WorldEvent): number | null => {
+  const blob = (event.payloadText || "") + " " + event.summary;
+  const json = /"(?:score|similarity|match_score)"\s*:\s*(\d+(?:\.\d+)?)/.exec(blob);
+  if (json) {
+    const value = Number(json[1]);
+    return value <= 1 ? Math.round(value * 100) : Math.round(Math.min(100, value));
+  }
+  const pct = /(\d{1,3})\s*%/.exec(blob);
+  return pct ? Math.min(100, Number(pct[1])) : null;
+};
+
+const parseVerdict = (event: WorldEvent, score: number | null): "match" | "diverge" | "unknown" => {
+  const blob = ((event.payloadText || "") + " " + event.summary).toLowerCase();
+  if (/"match"\s*:\s*false|diverg|diferente|mismatch/.test(blob)) return "diverge";
+  if (/"match"\s*:\s*true|equivalente|igual|\bmatch\b|alinhad/.test(blob)) return "match";
+  if (score !== null) return score >= 75 ? "match" : "diverge";
+  return "unknown";
+};
+
+const emptyZones = (): Record<ZoneId, ZoneWorldState> => {
+  const zones = {} as Record<ZoneId, ZoneWorldState>;
+  for (const zone of ZONES) {
+    zones[zone] = { level: "idle", owner: null, eventId: null, label: ZONE_LABEL[zone], since: null, count: 0 };
+  }
+  return zones;
+};
+
+const emptyFloors = () => {
+  const floors = {} as Record<SofiaFloorId, { recent: number; hot: boolean }>;
+  for (const floor of FLOORS) floors[floor] = { recent: 0, hot: false };
+  return floors;
+};
+
+export const reduceWorld = (
+  inputEvents: readonly WorldEvent[],
+  inputAgents: readonly WorldAgentInput[],
+  now: number,
+): WorldState => {
+  // Deterministic order: oldest first, ties by id.
+  const events = inputEvents
+    .filter((event) => event.ts <= now)
+    .slice()
+    .sort((a, b) => a.ts - b.ts || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
+  const newestFirst = events.slice().reverse();
+  const classified = new Map<string, ClassifiedEvent>();
+  for (const event of events) classified.set(event.id, classifyEvent(event));
+
+  const agentIds = inputAgents.map((agent) => agent.id).sort();
+  const statusById = new Map(inputAgents.map((agent) => [agent.id, lower(agent.status)]));
+  const available = (id: string) => statusById.has(id) && statusById.get(id) !== "error" && statusById.get(id) !== "offline";
+
+  const agents: Record<string, AgentWorldState> = {};
+  for (const id of agentIds) {
+    const running = statusById.get(id) === "running";
+    agents[id] = {
+      state: running ? "working" : "idle",
+      zone: null,
+      floorId: "openclaw-ground",
+      reason: running ? "run ativo no OpenClaw" : "",
+      eventId: null,
+      since: now,
+      substituteFor: null,
+      available: available(id),
+    };
+  }
+  const claimed = new Set<string>();
+  // Owner, or the first free available agent (deterministic order) as substitute.
+  const resolveAgent = (preferred: string): { id: string; substituteFor: string | null } | null => {
+    if (agents[preferred] && agents[preferred].available && !claimed.has(preferred)) return { id: preferred, substituteFor: null };
+    const free = agentIds.find((id) => agents[id].available && !claimed.has(id) && agents[id].state === "idle")
+      ?? agentIds.find((id) => agents[id].available && !claimed.has(id));
+    if (!free) return null;
+    return { id: free, substituteFor: preferred };
+  };
+  const claim = (id: string, state: SpatialState, zone: ZoneId | null, event: WorldEvent, reason: string, substituteFor: string | null) => {
+    claimed.add(id);
+    agents[id] = {
+      ...agents[id],
+      state,
+      zone,
+      floorId: zone ? ZONE_FLOOR[zone] : agents[id].floorId,
+      reason,
+      eventId: event.id,
+      since: event.ts,
+      substituteFor,
+    };
+  };
+
+  const zones = emptyZones();
+
+  // ---- Incident / War Room -------------------------------------------------
+  let incident: IncidentWorldState | null = null;
+  let incidentEvent: WorldEvent | null = null;
+  let recoveryEvent: WorldEvent | null = null;
+  for (const event of events) {
+    const info = classified.get(event.id)!;
+    if (info.critical) {
+      // A critical event opens a new incident when none is open (or the previous
+      // one recovered/expired); otherwise it joins the open incident's timeline.
+      if (!incidentEvent || recoveryEvent || event.ts - incidentEvent.ts > INCIDENT_TIMEOUT_MS) {
+        incidentEvent = event;
+        recoveryEvent = null;
+      }
