+  // ---- Event Fabric activity (newest claim wins) --------------------------
+  for (const event of newestFirst) {
+    if (now - event.ts > ACTIVITY_MS) break;
+    const info = classified.get(event.id)!;
+    if (info.critical || info.kind === "recovery" || info.kind.startsWith("agent.") || info.kind === "approval") continue;
