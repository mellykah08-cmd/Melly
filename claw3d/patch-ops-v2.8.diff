+    if (zone) zoneByAgentId[id] = zone;
+  }
+
+  // ---- Shadow Twin ----------------------------------------------------------
+  const shadow: ShadowWorldState = {
+    active: false,
+    correlationId: null,
+    candidate: null,
+    human: null,
+    compare: null,
+    counts: { candidate: 0, human: 0, compare: 0 },
+  };
+  const latestShadow = newestFirst.find((event) => classified.get(event.id)!.kind.startsWith("shadow."));
+  for (const event of events) {
+    const kind = classified.get(event.id)!.kind;
+    if (kind === "shadow.candidate") shadow.counts.candidate += 1;
+    if (kind === "shadow.human") shadow.counts.human += 1;
+    if (kind === "shadow.compare") shadow.counts.compare += 1;
+  }
+  if (latestShadow && now - latestShadow.ts <= SHADOW_MS) {
+    const correlation = latestShadow.correlationId ?? null;
+    shadow.active = true;
+    shadow.correlationId = correlation;
+    for (const event of newestFirst) {
+      if (now - event.ts > SHADOW_MS) break;
+      const kind = classified.get(event.id)!.kind;
+      if (!kind.startsWith("shadow.")) continue;
+      if (correlation && event.correlationId && event.correlationId !== correlation) continue;
+      const item = { id: event.id, ts: event.ts, summary: event.summary, synthetic: Boolean(event.synthetic) };
+      if (kind === "shadow.candidate" && !shadow.candidate) shadow.candidate = item;
+      if (kind === "shadow.human" && !shadow.human) shadow.human = item;
+      if (kind === "shadow.compare" && !shadow.compare) {
+        const score = parseScore(event);
+        shadow.compare = { ...item, score, verdict: parseVerdict(event, score) };
+      }
+    }
+  }
+
+  // ---- Projects (multi-project fabric) -------------------------------------
+  const projectMap = new Map<string, ProjectWorldState>();
+  const ensureProject = (id: string, label: string) => {
+    let project = projectMap.get(id);
+    if (!project) {
+      project = { id, label, health: 100, lastTs: 0, eventCount: 0, recentCount: 0, incident: false, lastSummary: "", sources: [], home: id === HOME_PROJECT };
+      projectMap.set(id, project);
+    }
+    return project;
+  };
+  ensureProject(HOME_PROJECT, "Sofia");
+  for (const event of events) {
+    const id = slugProject(event.project);
+    const project = ensureProject(id, id === HOME_PROJECT ? "Sofia" : (event.project ?? id).trim().slice(0, 40));
+    project.eventCount += 1;
+    project.lastTs = event.ts;
+    project.lastSummary = event.type + " · " + event.summary.slice(0, 100);
+    if (!project.sources.includes(event.source)) project.sources.push(event.source);
+    if (now - event.ts <= RECENT_MS) {
+      project.recentCount += 1;
+      if (event.severity === "critical") project.health -= 25;
+      else if (event.severity === "warning") project.health -= 7;
+    }
+  }
+  if (incident && incident.state !== "recuperando") ensureProject(incident.project, incident.project).incident = true;
+  const projects = [...projectMap.values()]
+    .map((project) => ({ ...project, health: Math.max(0, Math.min(100, project.health)) }))
+    .sort((a, b) => (a.home === b.home ? (a.id < b.id ? -1 : 1) : a.home ? -1 : 1))
+    .slice(0, 9);
+
+  // ---- Floors ---------------------------------------------------------------
+  const floorActivity = emptyFloors();
+  for (const event of newestFirst) {
+    if (now - event.ts > RECENT_MS) break;
+    const info = classified.get(event.id)!;
+    const floor = info.critical ? "command-sixth" : info.floorId;
+    floorActivity[floor].recent += 1;
+    if (now - event.ts <= HOT_MS) floorActivity[floor].hot = true;
+  }
+
+  // ---- Focus + mode ---------------------------------------------------------
+  let focus: WorldFocus | null = null;
+  if (incident && incident.state !== "recuperando") {
+    focus = {
+      zone: "warroom",
+      floorId: "command-sixth",
+      agentId: incident.responsible[0] ?? null,
+      eventId: incident.id,
+      reason: "War Room · " + incident.type,
+      priority: 3,
+    };
+  } else {
+    for (const event of newestFirst) {
+      if (now - event.ts > FOCUS_MS) break;
+      const info = classified.get(event.id)!;
+      if (info.kind === "agent.end") continue;
+      const agentId = Object.keys(agents).find((id) => agents[id].eventId === event.id) ?? null;
+      if (!agentId && info.kind !== "recovery") continue;
+      focus = {
+        zone: info.zone,
+        floorId: info.floorId,
+        agentId,
+        eventId: event.id,
+        reason: (agentId ? agentId + " · " : "") + event.type,
+        priority: event.severity === "critical" ? 3 : event.severity === "warning" ? 2 : 1,
+      };
+      break;
+    }
+  }
+
+  let mode: WorldMode = "nominal";
+  let alertLevel = 0;
+  if (incident && incident.state !== "recuperando") {
+    mode = "incident";
+    alertLevel = 1;
+  } else if (incident && incident.resolvedAt) {
+    mode = "recovery";
+    alertLevel = Math.max(0, 1 - (now - incident.resolvedAt) / RECOVERY_MS);
+  } else {
+    const latest = newestFirst.find((event) => now - event.ts <= MODE_MS && !classified.get(event.id)!.kind.startsWith("agent."));
+    const kind = latest ? classified.get(latest.id)!.kind : null;
+    if (kind && kind.startsWith("shadow.")) mode = "shadow";
+    else if (kind === "deploy") mode = "deploy";
+    else if (kind === "audit" || kind === "n8n.failed" || kind === "qa") mode = "audit";
+    else if (Object.values(agents).some((agent) => agent.state !== "idle")) mode = "working";
+  }
+
+  return {
+    at: now,
+    mode,
+    alertLevel: Math.round(alertLevel * 100) / 100,
+    focus,
+    agents,
+    zoneByAgentId,
+    zones,
+    incident,
+    shadow,
+    projects,
+    floorActivity,
+    eventCount: events.length,
+    syntheticActive: events.some((event) => event.synthetic && now - event.ts <= RECENT_MS),
+  };
+};
+
+// Changes only when something visible in space changes.
+export const worldSignature = (world: WorldState) =>
+  JSON.stringify([
+    world.mode,
+    Math.round(world.alertLevel * 10),
+    world.focus?.eventId ?? null,
+    world.focus?.agentId ?? null,
+    Object.entries(world.agents).map(([id, agent]) => [id, agent.state, agent.zone, agent.eventId, agent.substituteFor]),
+    world.incident ? [world.incident.id, world.incident.state, world.incident.responsible, world.incident.timeline.length] : null,
+    [world.shadow.active, world.shadow.candidate?.id, world.shadow.human?.id, world.shadow.compare?.id],
+    Object.entries(world.zones).map(([zone, state]) => [zone, state.level, state.owner, state.eventId]),
+    world.projects.map((project) => [project.id, project.health, project.incident, project.recentCount]),
+    Object.entries(world.floorActivity).map(([floor, activity]) => [floor, activity.recent, activity.hot]),
+  ]);
