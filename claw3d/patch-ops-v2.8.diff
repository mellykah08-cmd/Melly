+    zones[zone].count += 1;
+    // Desk work can involve several agents at once; every other zone has one owner.
+    const multiOwner = zone === "desk" && Boolean(event.agentId);
+    if (zones[zone].owner && !multiOwner) continue;
+    const preferred = multiOwner ? event.agentId! : ZONE_OWNER[zone];
+    if (multiOwner && claimed.has(preferred)) continue;
+    const pickResult = resolveAgent(preferred);
+    if (!pickResult) continue;
+    if (!zones[zone].owner) zones[zone].owner = pickResult.id;
+    claim(pickResult.id, ZONE_STATE[zone], zone, event, event.type + " · " + event.summary.slice(0, 80), pickResult.substituteFor);
+  }
