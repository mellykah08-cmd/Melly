+        level: recoveryEvent ? "recovering" : "alert",
+        owner: responsible[0] ?? null,
+        eventId: incidentEvent.id,
+        label: "War Room · " + incidentEvent.type,
+        since: incidentEvent.ts,
+        count: related.length,
+      };
+      if (ownerZone !== "warroom") {
+        zones[ownerZone] = {
+          level: recoveryEvent ? "recovering" : "alert",
+          owner: responsible[0] ?? null,
+          eventId: incidentEvent.id,
+          label: ZONE_LABEL[ownerZone] + " · incidente",
+          since: incidentEvent.ts,
+          count: 1,
+        };
+      }
+    }
+  }
