+        id: incidentEvent.id,
+        type: incidentEvent.type,
+        source: incidentEvent.source,
+        project: slugProject(incidentEvent.project),
+        summary: incidentEvent.summary,
+        openedAt: incidentEvent.ts,
+        state: recoveryEvent ? "recuperando" : now - incidentEvent.ts < CONVOCATION_MS ? "convocando" : "em andamento",
+        responsible,
+        ownerZone,
+        timeline: related.slice(-12).map((event) => ({
+          id: event.id,
+          ts: event.ts,
+          type: event.type,
+          severity: event.severity,
+          summary: event.summary,
+        })),
+        evidence: related
+          .filter((event) => event.severity === "critical" || event.severity === "warning")
+          .slice(-3)
