+// Sofia Spatial OS — pure spatial resolution (no React/three): where each World
+// State zone physically lives on the current floor, War Room seats, and the
+// per-agent destinations consumed by the scene's walk system.
+
+import { ITEM_FOOTPRINT, resolveItemTypeKey } from "@/features/retro-office/core/geometry";
+import { astar, buildNavGrid, type NavGrid } from "@/features/retro-office/core/navigation";
+import type { FurnitureItem } from "@/features/retro-office/core/types";
+import type { SofiaFloorId, ZoneId } from "@/lib/sofia-ops/worldState";
+
+export type Point = { x: number; y: number };
+export type Seat = Point & { facing: number };
+
+export const PRESET_FLOOR: Record<string, SofiaFloorId | null> = {
+  office: "openclaw-ground",
+  audit: "audit-second",
+  dev: "dev-third",
+  infra: "infra-fourth",
+  intel: "intel-fifth",
+  command: "command-sixth",
+  lobby: null,
+};
+
+// Which zones are this floor's own function (others render as remote hints).
+export const FLOOR_ZONES: Record<SofiaFloorId, ZoneId[]> = {
+  "openclaw-ground": ["infra", "audit", "qa", "shadow", "warroom"],
+  "audit-second": ["audit", "qa", "warroom"],
+  "dev-third": ["qa", "audit"],
+  "infra-fourth": ["infra", "warroom"],
+  "intel-fifth": ["intel", "shadow"],
+  "command-sixth": ["warroom", "infra", "audit", "shadow"],
+};
+
+
+export const itemCenter = (item: FurnitureItem): Point => {
+  const [fw, fh] = ITEM_FOOTPRINT[resolveItemTypeKey(item)] ?? [40, 40];
+  if (typeof item.r === "number") return { x: item.x + item.r, y: item.y + item.r };
+  return { x: item.x + (item.w ?? fw) / 2, y: item.y + (item.h ?? fh) / 2 };
+};
+
+const firstOf = (furniture: FurnitureItem[], types: string[]) => {
+  for (const type of types) {
+    const found = furniture.find((item) => item.type === type);
+    if (found) return found;
+  }
+  return null;
+};
+
+const biggestRoundTable = (furniture: FurnitureItem[]) =>
+  furniture
+    .filter((item) => item.type === "round_table")
+    .sort((a, b) => (b.r ?? 0) - (a.r ?? 0))[0] ?? null;
+
+// Seats for the War Room: the authored meeting room when the floor has one,
+// else the chairs around the floor's biggest round table, else a ring around it.
+export const resolveSofiaWarSeats = (furniture: FurnitureItem[], meetingSeats: Seat[]): Seat[] => {
+  if (meetingSeats.length >= 3) return meetingSeats;
+  const table = biggestRoundTable(furniture);
+  if (!table) return meetingSeats;
+  const center = itemCenter(table);
+  const radius = table.r ?? 60;
+  const faceTable = (x: number, y: number) => Math.atan2(center.x - x, center.y - y);
+  const chairs = furniture
+    .filter((item) => item.type === "chair")
+    .map((item) => itemCenter(item))
+    .filter((point) => Math.hypot(point.x - center.x, point.y - center.y) <= radius + 70)
+    .sort((a, b) => Math.atan2(a.y - center.y, a.x - center.x) - Math.atan2(b.y - center.y, b.x - center.x));
+  if (chairs.length >= 3) return chairs.map((point) => ({ ...point, facing: faceTable(point.x, point.y) }));
+  return Array.from({ length: 6 }, (_, index) => {
+    const angle = (index / 6) * Math.PI * 2;
+    const x = center.x + Math.cos(angle) * (radius + 30);
+    const y = center.y + Math.sin(angle) * (radius + 30);
+    return { x, y, facing: faceTable(x, y) };
+  });
+};
+
+// Physical anchor of every zone on the current floor (null = not on this floor).
+// Always derived from the floor's own furniture, so custom layouts (Sofia's
+// first floor moved the server room) are honoured.
+export const resolveZoneAnchors = (
+  furniture: FurnitureItem[],
+  floorId: SofiaFloorId,
+  warSeats: Seat[],
+): Record<ZoneId, Point | null> => {
+  const server = firstOf(furniture, ["server_terminal", "server_rack"]);
+  const qa = firstOf(furniture, ["qa_terminal", "device_rack"]);
+  const bench = firstOf(furniture, ["test_bench", "device_rack", "qa_terminal"]);
+  const booth = firstOf(furniture, ["sms_booth", "phone_booth"]);
+  const board = firstOf(furniture, ["whiteboard", "kanban_board"]);
+  const warCenter = warSeats.length
+    ? { x: warSeats.reduce((sum, seat) => sum + seat.x, 0) / warSeats.length, y: warSeats.reduce((sum, seat) => sum + seat.y, 0) / warSeats.length }
+    : null;
+  const qaAnchor = qa ? itemCenter(qa) : null;
+  const benchAnchor = bench ? itemCenter(bench) : null;
+  return {
+    desk: null,
+    infra: server ? itemCenter(server) : null,
+    audit: qaAnchor,
+    qa: benchAnchor && qaAnchor && Math.hypot(benchAnchor.x - qaAnchor.x, benchAnchor.y - qaAnchor.y) > 60 ? benchAnchor : qaAnchor ? { x: qaAnchor.x + 20, y: qaAnchor.y + 110 } : null,
+    shadow: booth ? itemCenter(booth) : floorId === "intel-fifth" && board ? { x: itemCenter(board).x - 120, y: itemCenter(board).y + 140 } : null,
+    warroom: warCenter,
+    intel: floorId === "intel-fifth" ? (board ? itemCenter(board) : { x: 1290, y: 300 }) : null,
+  };
+};
+
+export type SofiaTarget = { x: number; y: number; facing: number; pose: "stand" | "sit" };
+export type SofiaTargetSet = { targets: Record<string, SofiaTarget>; deskHolds: Record<string, boolean> };
+
+// World zones -> physical destinations on this floor. Stations: stand next to
+// the anchor item (A* snaps to the nearest walkable cell) facing it. War Room:
+// one seat per participant in stable order. Desk/intel work uses the agent's
+// assigned desk; zones missing on this floor fall back to desk work.
+export const resolveSofiaTargets = (
+  zoneByAgentId: Record<string, ZoneId>,
+  anchors: Record<ZoneId, Point | null>,
+  warSeats: Seat[],
+  stands?: Record<ZoneId, Point | null>,
+): SofiaTargetSet => {
+  const targets: Record<string, SofiaTarget> = {};
+  const deskHolds: Record<string, boolean> = {};
+  const warOrder = Object.keys(zoneByAgentId).filter((id) => zoneByAgentId[id] === "warroom").sort();
+  for (const [agentId, zone] of Object.entries(zoneByAgentId)) {
+    if (zone === "warroom") {
+      const seat = warSeats.length ? warSeats[warOrder.indexOf(agentId) % warSeats.length] : null;
+      if (seat) targets[agentId] = { x: seat.x, y: seat.y, facing: seat.facing, pose: "sit" };
+      else deskHolds[agentId] = true;
+      continue;
+    }
+    const anchor = zone === "desk" || zone === "intel" ? null : anchors[zone];
+    if (!anchor) {
+      deskHolds[agentId] = true;
+      continue;
+    }
+    // Stand at the validated walkable point (default: just south of the station), facing it.
+    const stand = stands?.[zone] ?? { x: anchor.x, y: anchor.y + 42 };
+    targets[agentId] = { x: stand.x, y: stand.y, facing: Math.atan2(anchor.x - stand.x, anchor.y - stand.y), pose: "stand" };
+  }
+  return { targets, deskHolds };
+};
+
+
+// ---------------------------------------------------------------------------
+// Reachability. Custom layouts can seal rooms on the 25px nav grid (Sofia's
+// first floor: the QA lab only opens onto a sealed corridor). Every station and
+// War Room seat is validated with the scene's own A*; unreachable ones move to
+// the nearest reachable point so agents never "arrive" without walking.
+// ---------------------------------------------------------------------------
+
+const HUB_CANDIDATES: Point[] = [
+  { x: 900, y: 400 },
+  { x: 700, y: 330 },
+  { x: 1000, y: 520 },
+];
+
+const resolveHub = (grid: NavGrid): Point => {
+  for (const hub of HUB_CANDIDATES) {
+    const probe = astar(hub.x, hub.y, hub.x + 50, hub.y, grid);
+    if (probe.length) return hub;
+  }
+  return HUB_CANDIDATES[0];
+};
+
+const isReachable = (grid: NavGrid, hub: Point, point: Point) => {
+  const path = astar(hub.x, hub.y, point.x, point.y, grid);
+  if (!path.length) return false;
+  const last = path[path.length - 1];
+  return Math.hypot(last.x - point.x, last.y - point.y) < 40;
+};
+
+export const nearestReachable = (grid: NavGrid, hub: Point, point: Point, maxRadius = 440): Point | null => {
+  if (isReachable(grid, hub, point)) return point;
+  for (let radius = 40; radius <= maxRadius; radius += 40) {
+    let best: Point | null = null;
+    let bestScore = Infinity;
+    for (let k = 0; k < 12; k += 1) {
+      const angle = (k / 12) * Math.PI * 2;
+      const candidate = { x: Math.round(point.x + Math.cos(angle) * radius), y: Math.round(point.y + Math.sin(angle) * radius) };
+      if (candidate.x < 20 || candidate.x > 1780 || candidate.y < 20 || candidate.y > 700) continue;
+      // Prefer candidates toward the hub (outside the sealed room's door side).
+      const score = Math.hypot(candidate.x - hub.x, candidate.y - hub.y);
+      if (score < bestScore && isReachable(grid, hub, candidate)) {
+        best = candidate;
+        bestScore = score;
+      }
+    }
+    if (best) return best;
+  }
+  return null;
+};
+
+export type SpatialLayout = {
+  // Visual centre of each zone's station (the furniture it belongs to).
+  anchors: Record<ZoneId, Point | null>;
+  // Walkable point where the responsible agent stands (validated with A*).
+  stands: Record<ZoneId, Point | null>;
+  warSeats: Seat[];
+  relocated: ZoneId[];
+};
+
+// Own room first; semantic fallbacks when that room is sealed on this floor
+// (audit work moves to the review boards, QA to the lounge table, …).
+const ZONE_ITEMS: Record<"infra" | "audit" | "qa" | "shadow", string[][]> = {
+  infra: [["server_terminal", "server_rack"], ["kanban_board", "whiteboard", "table_rect"]],
+  audit: [["qa_terminal", "device_rack"], ["whiteboard", "kanban_board", "table_rect"]],
+  qa: [["test_bench", "device_rack", "qa_terminal"], ["whiteboard", "table_rect", "kanban_board"]],
+  shadow: [["sms_booth", "phone_booth"], ["table_rect", "kanban_board", "whiteboard"]],
+};
+
+// Try the four sides of an item (south first: rooms open toward the floor).
+const standCandidates = (item: FurnitureItem): Point[] => {
+  const center = itemCenter(item);
+  const [fw, fh] = ITEM_FOOTPRINT[resolveItemTypeKey(item)] ?? [40, 40];
+  const halfW = (item.w ?? fw) / 2;
+  const halfH = (item.h ?? fh) / 2;
+  return [
+    { x: center.x, y: center.y + halfH + 28 },
+    { x: center.x - halfW - 28, y: center.y },
+    { x: center.x + halfW + 28, y: center.y },
+    { x: center.x, y: center.y - halfH - 28 },
+  ];
+};
+
+const reachableItem = (furniture: FurnitureItem[], grid: NavGrid, hub: Point, types: string[], used: Set<string>) => {
+  for (const type of types) {
+    for (const item of furniture) {
+      if (item.type !== type || used.has(item._uid)) continue;
+      const stand = standCandidates(item).find((point) => isReachable(grid, hub, point));
+      if (stand) return { item, stand };
+    }
+  }
+  return null;
+};
+
+const arcSeats = (focus: Point, grid: NavGrid, hub: Point): Seat[] => {
+  const center = { x: focus.x, y: focus.y + 95 };
+  const seats: Seat[] = [];
+  for (let index = 0; index < 7 && seats.length < 6; index += 1) {
+    const angle = (-70 + index * (140 / 6)) * (Math.PI / 180);
+    const x = Math.round(center.x + Math.sin(angle) * 70);
+    const y = Math.round(center.y + Math.cos(angle) * 35);
+    if (isReachable(grid, hub, { x, y })) seats.push({ x, y, facing: Math.atan2(focus.x - x, focus.y - y) });
+  }
+  return seats;
+};
+
+export const resolveSpatialLayout = (
+  furniture: FurnitureItem[],
+  floorId: SofiaFloorId,
+  meetingSeats: Seat[],
+): SpatialLayout => {
+  const grid = buildNavGrid(furniture);
+  const hub = resolveHub(grid);
+  const relocated: ZoneId[] = [];
+  const raw = resolveZoneAnchors(furniture, floorId, []);
+  const anchors: Record<ZoneId, Point | null> = { ...raw, warroom: null };
+  const stands: Record<ZoneId, Point | null> = { desk: null, infra: null, audit: null, qa: null, shadow: null, warroom: null, intel: null };
+  const used = new Set<string>();
+
+  // War Room first: the authored meeting seats / round-table chairs, else an
+  // arc in front of the kanban board (the most visible free wall).
+  const rawSeats = resolveSofiaWarSeats(furniture, meetingSeats);
+  let warSeats = rawSeats.filter((seat) => isReachable(grid, hub, seat));
+  if (warSeats.length < 3) {
+    if (rawSeats.length) relocated.push("warroom");
+    const board = furniture.find((item) => item.type === "kanban_board" && standCandidates(item).some((point) => isReachable(grid, hub, point)))
+      ?? furniture.find((item) => item.type === "whiteboard" && standCandidates(item).some((point) => isReachable(grid, hub, point)));
+    if (board) {
+      used.add(board._uid);
+      warSeats = arcSeats(itemCenter(board), grid, hub);
+    }
+  }
+  if (warSeats.length) {
+    anchors.warroom = {
+      x: warSeats.reduce((sum, seat) => sum + seat.x, 0) / warSeats.length,
+      y: warSeats.reduce((sum, seat) => sum + seat.y, 0) / warSeats.length,
+    };
+    stands.warroom = anchors.warroom;
+  }
+
+  for (const zone of ["infra", "audit", "qa", "shadow"] as const) {
+    if (!raw[zone]) continue;
+    const [own, fallback] = ZONE_ITEMS[zone];
+    const found = reachableItem(furniture, grid, hub, own, used);
+    if (found) {
+      anchors[zone] = itemCenter(found.item);
+      stands[zone] = found.stand;
+      used.add(found.item._uid);
+      continue;
+    }
+    relocated.push(zone);
+    const alternative = reachableItem(furniture, grid, hub, fallback, used);
+    if (alternative) {
+      anchors[zone] = itemCenter(alternative.item);
+      stands[zone] = alternative.stand;
+      used.add(alternative.item._uid);
+      continue;
+    }
+    const near = nearestReachable(grid, hub, raw[zone]!);
+    anchors[zone] = near;
+    stands[zone] = near;
+  }
+  return { anchors, stands, warSeats, relocated };
+};
