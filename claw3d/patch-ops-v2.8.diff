+"use client";
+
+// Sofia Spatial OS — everything the World State shows inside the 3D office.
+// Reads only the world view (live or replay snapshot); positions come from the
+// authored furniture of the current floor, so each floor reacts in its own rooms.
+// Lights: exactly one ambient + one point light, always mounted (no shader
+// recompiles on mobile); colour/intensity are lerped per frame.
+
+import { useEffect, useMemo, useRef, useState, type MutableRefObject, type RefObject } from "react";
+import { useFrame, useThree } from "@react-three/fiber";
+import { Billboard } from "@react-three/drei";
+import * as THREE from "three";
+import { SofiaSafeText as Text } from "@/features/sofia-ops/SafeText";
+import { toWorld } from "@/features/retro-office/core/geometry";
+import type { FurnitureItem, RenderAgent } from "@/features/retro-office/core/types";
+import { sofiaWorld, type SofiaWorldView } from "@/lib/sofia-ops/worldStore";
+import {
+  FLOOR_LABEL,
+  STATE_LABEL,
+  ZONE_LABEL,
+  type SofiaFloorId,
+  type SpatialState,
+  type WorldState,
+  type ZoneId,
+  type ZoneWorldState,
+} from "@/lib/sofia-ops/worldState";
+
+import {
+  FLOOR_ZONES,
+  PRESET_FLOOR,
+  type Point,
+} from "@/features/sofia-ops/spatialTargets";
+
+export {
+  FLOOR_ZONES,
+  PRESET_FLOOR,
+  resolveSofiaTargets,
+  resolveSofiaWarSeats,
+  resolveSpatialLayout,
+  resolveZoneAnchors,
+  type SofiaTarget,
+  type SofiaTargetSet,
+} from "@/features/sofia-ops/spatialTargets";
+
+export const ZONE_COLOR: Record<ZoneId, string> = {
+  desk: "#22d3ee",
+  infra: "#38bdf8",
+  audit: "#f59e0b",
+  qa: "#facc15",
+  shadow: "#a78bfa",
+  warroom: "#ef4444",
+  intel: "#34d399",
+};
+
+export const STATE_COLOR: Record<SpatialState, string> = {
+  idle: "#64748b",
+  working: "#38bdf8",
+  thinking: "#facc15",
+  auditing: "#f59e0b",
+  meeting: "#ef4444",
+  incident: "#ff2d55",
+  shadow: "#a78bfa",
+};
+
+const FLOOR_PURPOSE: Record<SofiaFloorId, string> = {
+  "openclaw-ground": "atendimento, execução e Shadow Twin",
+  "audit-second": "revisão, workflows n8n e qualidade",
+  "dev-third": "desenvolvimento, testes e regressão",
+  "infra-fourth": "Railway, deploys e disponibilidade",
+  "intel-fifth": "analytics, padrões e comparação",
+  "command-sixth": "incidentes e visão global",
+};
+
+const levelColor = (zone: ZoneId, level: ZoneWorldState["level"]) =>
+  level === "alert" ? "#ff3b4f" : level === "recovering" ? "#34d399" : ZONE_COLOR[zone];
+
+const useSecondTick = (enabled: boolean) => {
+  const [, setTick] = useState(0);
+  useEffect(() => {
+    if (!enabled) return;
+    const timer = window.setInterval(() => setTick((value) => value + 1), 1000);
+    return () => window.clearInterval(timer);
+  }, [enabled]);
+};
+
+const elapsed = (from: number, to: number) => {
+  const seconds = Math.max(0, Math.floor((to - from) / 1000));
+  return String(Math.floor(seconds / 60)).padStart(2, "0") + ":" + String(seconds % 60).padStart(2, "0");
+};
+
+function Label({ text, color, size = 0.2, y = 0 }: { text: string; color: string; size?: number; y?: number }) {
+  return (
+    <Billboard position={[0, y, 0]}>
+      <Text fontSize={size} color={color} anchorX="center" anchorY="bottom" outlineWidth={size * 0.12} outlineColor="#020617" maxWidth={3.2} textAlign="center">
+        {text}
+      </Text>
+    </Billboard>
+  );
+}
+
+function ZoneStation({
+  zone,
+  anchor,
+  state,
+  ownerName,
+  remote,
+}: {
+  zone: ZoneId;
+  anchor: Point;
+  state: ZoneWorldState;
+  ownerName: string | null;
+  remote: boolean;
+}) {
+  const ring = useRef<THREE.Mesh>(null);
+  const pillar = useRef<THREE.Mesh>(null);
+  const active = state.level !== "idle";
+  const color = levelColor(zone, state.level);
+  const [wx, , wz] = toWorld(anchor.x, anchor.y);
+  useFrame(({ clock }) => {
+    const t = clock.elapsedTime;
+    const speed = state.level === "alert" ? 7 : 3;
+    const pulse = active ? 0.5 + 0.5 * Math.sin(t * speed) : 0;
+    if (ring.current) {
+      const material = ring.current.material as THREE.MeshBasicMaterial;
+      material.opacity = active ? 0.45 + pulse * 0.45 : remote ? 0.12 : 0.22;
+      const scale = active ? 1 + pulse * 0.12 : 1;
+      ring.current.scale.set(scale, scale, scale);
+    }
+    if (pillar.current) {
+      const material = pillar.current.material as THREE.MeshBasicMaterial;
+      material.opacity = active ? 0.12 + pulse * 0.16 : 0;
+      pillar.current.visible = active;
+    }
+  });
+  return (
+    <group position={[wx, 0, wz]}>
+      <mesh
+        ref={ring}
+        rotation={[-Math.PI / 2, 0, 0]}
+        position={[0, 0.03, 0]}
+        onClick={(event) => {
+          event.stopPropagation();
+          sofiaWorld.inspect({ kind: "zone", id: zone });
+        }}
+      >
+        <ringGeometry args={[0.42, 0.56, 6]} />
+        <meshBasicMaterial color={color} transparent opacity={0.22} depthWrite={false} side={THREE.DoubleSide} />
+      </mesh>
+      <mesh ref={pillar} position={[0, 0.9, 0]} visible={false}>
+        <cylinderGeometry args={[0.36, 0.48, 1.8, 6, 1, true]} />
+        <meshBasicMaterial color={color} transparent opacity={0} depthWrite={false} side={THREE.DoubleSide} />
+      </mesh>
+      {active ? (
+        <Label
+          y={2.05}
+          size={0.21}
+          color={color}
+          text={(ZONE_LABEL[zone] + (state.level === "alert" ? " · ALERTA" : state.level === "recovering" ? " · RECUPERANDO" : " · ATIVO")).toUpperCase() + (ownerName ? "\n" + ownerName : "")}
+        />
+      ) : remote ? null : (
+        <Label y={0.1} size={0.13} color="#94a3b8" text={ZONE_LABEL[zone].toUpperCase()} />
+      )}
+    </group>
+  );
+}
+
+function WarRoomBeacon({ anchor, world, names, at }: { anchor: Point; world: WorldState; names: Map<string, string>; at: number | null }) {
+  const incident = world.incident;
+  useSecondTick(Boolean(incident));
+  const beacon = useRef<THREE.Mesh>(null);
+  const recovering = incident?.state === "recuperando";
+  useFrame(({ clock }, delta) => {
+    if (!beacon.current) return;
+    beacon.current.rotation.y += delta * (recovering ? 0.8 : 2.6);
+    beacon.current.position.y = 2.25 + Math.sin(clock.elapsedTime * 2) * 0.06;
+  });
+  if (!incident) return null;
+  const [wx, , wz] = toWorld(anchor.x, anchor.y);
+  const color = recovering ? "#34d399" : "#ff2d55";
+  const people = incident.responsible.map((id) => names.get(id) ?? id).join(", ");
+  return (
+    <group position={[wx, 0, wz]}>
+      <mesh
+        ref={beacon}
+        position={[0, 2.25, 0]}
+        onClick={(event) => {
+          event.stopPropagation();
+          sofiaWorld.inspect({ kind: "incident", id: incident.id });
+        }}
+      >
+        <octahedronGeometry args={[0.2, 0]} />
+        <meshBasicMaterial color={color} wireframe />
+      </mesh>
+      <Label
+        y={2.6}
+        size={0.24}
+        color={color}
+        text={
+          (recovering ? "RECUPERADO · " : "WAR ROOM · ") +
+          incident.type +
+          "\n" +
+          (recovering ? "voltando às atividades" : incident.state + " · " + elapsed(incident.openedAt, at ?? Date.now())) +
+          (people && !recovering ? "\n" + people : "")
+        }
+      />
+    </group>
+  );
+}
+
+function Hologram({ position, color, label, flicker }: { position: [number, number, number]; color: string; label: string; flicker: number }) {
+  const group = useRef<THREE.Group>(null);
+  useFrame(({ clock }) => {
+    if (!group.current) return;
+    const t = clock.elapsedTime + flicker;
+    group.current.position.y = position[1] + Math.sin(t * 1.6) * 0.04;
+    group.current.rotation.y = t * 0.4;
+    group.current.children.forEach((child) => {
+      const mesh = child as THREE.Mesh;
+      const material = mesh.material as THREE.MeshBasicMaterial | undefined;
+      if (material && "opacity" in material) material.opacity = 0.32 + 0.18 * Math.abs(Math.sin(t * 5.3));
+    });
+  });
+  return (
+    <group position={position}>
+      <group ref={group}>
+        <mesh position={[0, 0.45, 0]}>
+          <cylinderGeometry args={[0.14, 0.18, 0.62, 10]} />
+          <meshBasicMaterial color={color} wireframe transparent opacity={0.4} depthWrite={false} />
+        </mesh>
+        <mesh position={[0, 0.9, 0]}>
+          <sphereGeometry args={[0.13, 12, 8]} />
+          <meshBasicMaterial color={color} wireframe transparent opacity={0.4} depthWrite={false} />
+        </mesh>
+      </group>
+      <Label y={1.12} size={0.15} color={color} text={label} />
+    </group>
+  );
+}
+
+function ShadowTwin({ anchor, world }: { anchor: Point; world: WorldState }) {
+  const shadow = world.shadow;
+  const beam = useRef<THREE.Mesh>(null);
+  useFrame(({ clock }) => {
+    if (!beam.current) return;
+    const material = beam.current.material as THREE.MeshBasicMaterial;
+    material.opacity = 0.45 + 0.35 * Math.sin(clock.elapsedTime * 4);
+  });
+  if (!shadow.active) return null;
+  // Twin pair stands just in front of the station so real NPCs keep the booth.
+  const [wx, , wz] = toWorld(anchor.x, anchor.y + 120);
+  const compare = shadow.compare;
+  const verdictColor = compare?.verdict === "match" ? "#34d399" : compare?.verdict === "diverge" ? "#fb923c" : "#e2e8f0";
+  return (
+    <group position={[wx, 0, wz]}>
+      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, 0.025, 0]}>
+        <ringGeometry args={[0.95, 1.0, 48]} />
+        <meshBasicMaterial color="#a78bfa" transparent opacity={0.55} depthWrite={false} side={THREE.DoubleSide} />
+      </mesh>
+      {shadow.candidate ? <Hologram position={[-0.42, 0, 0]} color="#a78bfa" label={"SOFIA · SHADOW"} flicker={0} /> : null}
+      {shadow.human ? <Hologram position={[0.42, 0, 0]} color="#22d3ee" label={"HUMANO · REAL"} flicker={1.7} /> : null}
+      {shadow.candidate && shadow.human ? (
+        <mesh ref={beam} position={[0, 0.7, 0]} rotation={[0, 0, Math.PI / 2]}>
+          <cylinderGeometry args={[0.018, 0.018, 0.84, 6]} />
+          <meshBasicMaterial color={compare ? verdictColor : "#c4b5fd"} transparent opacity={0.6} depthWrite={false} />
+        </mesh>
+      ) : null}
+      <Label
+        y={1.62}
+        size={0.19}
+        color={compare ? verdictColor : "#c4b5fd"}
+        text={
+          compare
+            ? "COMPARAÇÃO · " + (compare.score !== null ? compare.score + "% · " : "") + (compare.verdict === "match" ? "equivalente" : compare.verdict === "diverge" ? "divergente" : "em análise")
+            : shadow.human
+              ? "SHADOW TWIN · aguardando comparação"
+              : "SHADOW TWIN · candidata gerada"
+        }
+      />
+      <Label y={0.06} size={0.11} color="#c4b5fd" text="SHADOW · nada é enviado" />
+    </group>
+  );
+}
+
+function AgentAura({
+  id,
+  state,
+  label,
+  lookupRef,
+}: {
+  id: string;
+  state: SpatialState;
+  label: string;
+  lookupRef: RefObject<Map<string, RenderAgent>>;
+}) {
+  const group = useRef<THREE.Group>(null);
+  const ring = useRef<THREE.Mesh>(null);
+  const color = STATE_COLOR[state];
+  useFrame(({ clock }) => {
+    const agent = lookupRef.current?.get(id);
+    if (!group.current) return;
+    if (!agent) {
+      group.current.visible = false;
+      return;
+    }
+    const [x, , z] = toWorld(agent.x, agent.y);
+    group.current.visible = true;
+    group.current.position.set(x, 0, z);
+    if (ring.current) {
+      const fast = state === "incident" || state === "meeting";
+      const pulse = 0.5 + 0.5 * Math.sin(clock.elapsedTime * (fast ? 6 : 3) + x);
+      ring.current.scale.setScalar(1 + pulse * 0.18);
+      (ring.current.material as THREE.MeshBasicMaterial).opacity = 0.5 + pulse * 0.4;
+    }
+  });
+  return (
+    <group ref={group} visible={false}>
+      <mesh ref={ring} rotation={[-Math.PI / 2, 0, 0]} position={[0, 0.035, 0]}>
+        <ringGeometry args={[0.2, 0.28, 28]} />
+        <meshBasicMaterial color={color} transparent opacity={0.8} depthWrite={false} side={THREE.DoubleSide} />
+      </mesh>
+      <Label y={2.22} size={0.17} color={color} text={label} />
+    </group>
+  );
+}
+
+function ProjectTowers({ world }: { world: WorldState }) {
+  const groups = useRef<(THREE.Mesh | null)[]>([]);
+  useFrame(({ clock }) => {
+    groups.current.forEach((mesh, index) => {
+      const project = world.projects[index];
+      if (!mesh || !project) return;
+      const material = mesh.material as THREE.MeshBasicMaterial;
+      material.opacity = project.incident ? 0.35 + 0.3 * Math.abs(Math.sin(clock.elapsedTime * 5)) : project.recentCount ? 0.42 : 0.26;
+    });
+  });
+  // Campus row just south of the office wall; Sofia (this building) first.
+  const count = world.projects.length;
+  if (count === 0) return null;
+  return (
+    <group>
+      {world.projects.map((project, index) => {
+        const x = 900 + (index - (count - 1) / 2) * 190;
+        const [wx, , wz] = toWorld(x, 812);
+        const height = 0.5 + Math.min(1.5, project.recentCount * 0.14 + project.eventCount * 0.01);
+        const color = project.incident ? "#ff2d55" : project.health >= 80 ? "#22d3ee" : project.health >= 50 ? "#f59e0b" : "#ef4444";
+        return (
+          <group
+            key={project.id}
+            position={[wx, 0, wz]}
+            onClick={(event) => {
+              event.stopPropagation();
+              sofiaWorld.inspect({ kind: "project", id: project.id });
+            }}
+          >
+            <mesh ref={(mesh) => { groups.current[index] = mesh; }} position={[0, height / 2, 0]}>
+              <boxGeometry args={[0.55, height, 0.55]} />
+              <meshBasicMaterial color={color} transparent opacity={0.3} depthWrite={false} />
+            </mesh>
+            <mesh position={[0, height / 2, 0]}>
+              <boxGeometry args={[0.56, height, 0.56]} />
+              <meshBasicMaterial color={color} wireframe />
+            </mesh>
+            <Label y={height + 0.1} size={0.17} color={color} text={(project.home ? project.label.toUpperCase() + " · este prédio" : project.label.toUpperCase()) + "\n" + project.health + "%"} />
+          </group>
+        );
+      })}
+    </group>
+  );
+}
+
+function FocusMarker({ world, anchors, lookupRef }: { world: WorldState; anchors: Record<ZoneId, Point | null>; lookupRef: RefObject<Map<string, RenderAgent>> }) {
+  const cone = useRef<THREE.Mesh>(null);
+  const focus = world.focus;
+  useFrame(({ clock }) => {
+    if (!cone.current) return;
+    if (!focus) {
+      cone.current.visible = false;
+      return;
+    }
+    const agent = focus.agentId ? lookupRef.current?.get(focus.agentId) : undefined;
+    const point = agent ? { x: agent.x, y: agent.y } : anchors[focus.zone];
+    if (!point) {
+      cone.current.visible = false;
+      return;
+    }
+    const [x, , z] = toWorld(point.x, point.y);
+    cone.current.visible = true;
+    cone.current.position.set(x, 1.75 + Math.sin(clock.elapsedTime * 3) * 0.08, z);
+    cone.current.rotation.y += 0.03;
+  });
+  const color = focus?.priority === 3 ? "#ff2d55" : focus?.priority === 2 ? "#f59e0b" : "#22d3ee";
+  return (
+    <mesh ref={cone} visible={false} rotation={[Math.PI, 0, 0]}>
+      <coneGeometry args={[0.1, 0.22, 4]} />
+      <meshBasicMaterial color={color} />
+    </mesh>
+  );
+}
+
+function FloorBoard({ floorId, world }: { floorId: SofiaFloorId; world: WorldState }) {
+  const zones = FLOOR_ZONES[floorId];
+  const activeHere = zones.filter((zone) => world.zones[zone].level !== "idle");
+  const elsewhere = (Object.keys(world.floorActivity) as SofiaFloorId[]).filter((floor) => floor !== floorId && world.floorActivity[floor].hot);
+  const [wx, , wz] = toWorld(900, 70);
+  const text =
+    FLOOR_LABEL[floorId].toUpperCase() +
+    " · " +
+    FLOOR_PURPOSE[floorId] +
+    "\n" +
+    (activeHere.length ? "ativo: " + activeHere.map((zone) => ZONE_LABEL[zone]).join(", ") : "sem atividade neste andar") +
+    (elsewhere.length ? "\natividade em: " + elsewhere.map((floor) => FLOOR_LABEL[floor]).join(", ") : "");
+  return (
+    <group position={[wx, 0, wz]}>
+      <Label y={2.2} size={0.21} color={activeHere.length ? "#e2e8f0" : "#94a3b8"} text={text} />
+    </group>
+  );
+}
+
+// Camera follows the World Director focus gently: glides on a new focus, then
+// only re-centres when the subject drifts out of a dead zone. Any user touch
+// pauses it for 12 s. Disabled while the third-person follow cam is active.
+function AutoFollowCamera({
+  view,
+  anchors,
+  orbitRef,
+  lookupRef,
+  followRef,
+}: {
+  view: SofiaWorldView;
+  anchors: Record<ZoneId, Point | null>;
+  orbitRef: MutableRefObject<{ target: THREE.Vector3; update: () => void } | null>;
+  lookupRef: RefObject<Map<string, RenderAgent>>;
+  followRef?: MutableRefObject<string | null>;
+}) {
+  const { gl, camera } = useThree();
+  const lastUserRef = useRef(0);
+  const glidingRef = useRef(false);
+  const focusKeyRef = useRef<string | null>(null);
+  const glideRequestRef = useRef(view.glideRequest);
+  const desired = useMemo(() => new THREE.Vector3(), []);
+  const offset = useMemo(() => new THREE.Vector3(), []);
+  useEffect(() => {
+    const element = gl.domElement;
+    const mark = () => {
+      lastUserRef.current = performance.now();
+      glidingRef.current = false;
+    };
+    element.addEventListener("pointerdown", mark);
+    element.addEventListener("wheel", mark, { passive: true });
+    element.addEventListener("touchstart", mark, { passive: true });
+    return () => {
+      element.removeEventListener("pointerdown", mark);
+      element.removeEventListener("wheel", mark);
+      element.removeEventListener("touchstart", mark);
+    };
+  }, [gl]);
+  const focus = view.world.focus;
+  const key = focus ? focus.eventId + ":" + (focus.agentId ?? "") : null;
+  useEffect(() => {
+    if (key === focusKeyRef.current) return;
+    focusKeyRef.current = key;
+    if (key) glidingRef.current = true;
+  }, [key]);
+  useEffect(() => {
+    if (view.glideRequest === glideRequestRef.current) return;
+    glideRequestRef.current = view.glideRequest;
+    glidingRef.current = true;
+    lastUserRef.current = 0;
+  }, [view.glideRequest]);
+  useFrame((_, delta) => {
+    const controls = orbitRef.current;
+    if (!controls || !focus || followRef?.current) return;
+    const manual = !view.autoFollow;
+    if (manual && !glidingRef.current) return;
+    if (!manual && performance.now() - lastUserRef.current < 12000) return;
+    const agent = focus.agentId ? lookupRef.current?.get(focus.agentId) : undefined;
+    const point = agent ? { x: agent.x, y: agent.y } : anchors[focus.zone];
+    if (!point) return;
+    const [x, , z] = toWorld(point.x, point.y);
+    desired.set(x, controls.target.y, z);
+    const distance = controls.target.distanceTo(desired);
+    if (!glidingRef.current && distance < 2.2) return;
+    glidingRef.current = distance > 0.08;
+    const step = 1 - Math.exp(-Math.min(delta, 0.1) * 2.4);
+    offset.copy(desired).sub(controls.target).multiplyScalar(step);
+    controls.target.add(offset);
+    camera.position.add(offset);
+    controls.update();
+  });
+  return null;
+}
+
+function AlertLighting({ world, replay }: { world: WorldState; replay: boolean }) {
+  const ambient = useRef<THREE.AmbientLight>(null);
+  const point = useRef<THREE.PointLight>(null);
+  const targetColor = useMemo(() => new THREE.Color(), []);
+  const pointColor = useMemo(() => new THREE.Color(), []);
+  useFrame(({ clock }, delta) => {
+    const k = 1 - Math.exp(-Math.min(delta, 0.1) * 1.8);
+    const alert = world.alertLevel;
+    const mode = world.mode;
+    if (ambient.current) {
+      targetColor.set(replay ? "#e8dcc4" : mode === "incident" ? "#ffd0d5" : mode === "recovery" ? "#d5f5e3" : mode === "shadow" ? "#ddd6fe" : "#d8d4c8");
+      ambient.current.color.lerp(targetColor, k);
+      const intensity = replay ? 0.62 : 0.72 - alert * 0.16;
+      ambient.current.intensity += (intensity - ambient.current.intensity) * k;
+    }
+    if (point.current) {
+      pointColor.set(mode === "incident" ? "#ff334d" : mode === "recovery" ? "#34d399" : mode === "audit" ? "#f59e0b" : mode === "deploy" ? "#38bdf8" : mode === "shadow" ? "#a78bfa" : "#ffffff");
+      point.current.color.lerp(pointColor, k);
+      const pulse = mode === "incident" ? 0.75 + 0.25 * Math.sin(clock.elapsedTime * 5) : 1;
+      const intensity = mode === "incident" ? 5.5 * pulse : mode === "recovery" ? 3.2 * alert : mode === "nominal" || mode === "working" ? 0 : 1.6;
+      point.current.intensity += (intensity - point.current.intensity) * k;
+    }
+  });
+  return (
+    <>
+      <ambientLight ref={ambient} intensity={0.72} color="#d8d4c8" />
+      <pointLight ref={point} position={[0, 4.2, -9.5]} intensity={0} distance={22} decay={1.4} color="#ffffff" />
+    </>
+  );
+}
+
+
+// Observability: a throttled, read-only snapshot of where agents physically are
+// (used by E2E and the inspector); no React state, ~2 writes per second.
+function SpatialProbe({ lookupRef, orbitRef }: { lookupRef: RefObject<Map<string, RenderAgent>>; orbitRef: MutableRefObject<{ target: THREE.Vector3; update: () => void } | null> }) {
+  const lastRef = useRef(0);
+  useFrame(() => {
+    const now = performance.now();
+    if (now - lastRef.current < 500) return;
+    lastRef.current = now;
+    const out: Record<string, { x: number; y: number; tx: number; ty: number; state: string; target: string | null; pose: string | null; path: number }> = {};
+    lookupRef.current?.forEach((agent, id) => {
+      out[id] = {
+        x: Math.round(agent.x),
+        y: Math.round(agent.y),
+        tx: Math.round(agent.targetX),
+        ty: Math.round(agent.targetY),
+        state: agent.state,
+        target: agent.interactionTarget ?? null,
+        pose: agent.sofiaPose ?? null,
+        path: agent.path?.length ?? 0,
+      };
+    });
+    const holder = window as Window & { __SOFIA_AGENT_POS?: typeof out; __SOFIA_CAMERA_TARGET?: number[] };
+    holder.__SOFIA_AGENT_POS = out;
+    const target = orbitRef.current?.target;
+    if (target) holder.__SOFIA_CAMERA_TARGET = [target.x, target.y, target.z];
+  });
+  return null;
+}
+
+export function SofiaSpatialLayer({
+  view,
+  layoutPreset,
+  anchors,
+  agentLookupRef,
+  orbitRef,
+  followRef,
+  agentNames,
+}: {
+  view: SofiaWorldView;
+  layoutPreset: string;
+  anchors: Record<ZoneId, Point | null> | null;
+  agentLookupRef: RefObject<Map<string, RenderAgent>>;
+  orbitRef: MutableRefObject<{ target: THREE.Vector3; update: () => void } | null>;
+  followRef?: MutableRefObject<string | null>;
+  agentNames: Map<string, string>;
+}) {
+  const world = view.world;
+  const floorId = PRESET_FLOOR[layoutPreset] ?? null;
+  const ownZones = floorId ? FLOOR_ZONES[floorId] : [];
+  const activeAgents = Object.entries(world.agents).filter(([, agent]) => agent.state !== "idle");
+  return (
+    <>
+      <AlertLighting world={world} replay={view.replay.active} />
+      <SpatialProbe lookupRef={agentLookupRef} orbitRef={orbitRef} />
+      {floorId && anchors ? (
+        <>
+          {(Object.keys(anchors) as ZoneId[]).map((zone) => {
+            const anchor = anchors[zone];
+            if (!anchor || zone === "desk") return null;
+            const state = world.zones[zone];
+            return (
+              <ZoneStation
+                key={zone}
+                zone={zone}
+                anchor={anchor}
+                state={state}
+                ownerName={state.owner ? agentNames.get(state.owner) ?? state.owner : null}
+                remote={!ownZones.includes(zone)}
+              />
+            );
+          })}
+          {anchors.warroom ? <WarRoomBeacon anchor={anchors.warroom} world={world} names={agentNames} at={view.replay.at} /> : null}
+          {anchors.shadow ? <ShadowTwin anchor={anchors.shadow} world={world} /> : null}
+          {activeAgents.map(([id, agent]) => (
+            <AgentAura
+              key={id}
+              id={id}
+              state={agent.state}
+              lookupRef={agentLookupRef}
+              label={STATE_LABEL[agent.state].toUpperCase() + (agent.substituteFor ? " · substituto" : "")}
+            />
+          ))}
+          <FocusMarker world={world} anchors={anchors} lookupRef={agentLookupRef} />
+          <FloorBoard floorId={floorId} world={world} />
+          <ProjectTowers world={world} />
+          <AutoFollowCamera view={view} anchors={anchors} orbitRef={orbitRef} lookupRef={agentLookupRef} followRef={followRef} />
+        </>
+      ) : null}
+    </>
+  );
+}
