+import {describe,it,expect} from 'vitest';
+import {ShortReplay} from '@/features/sofia-ops/ShortReplay';
+describe('bounded spatial observation replay',()=>{
+ it('keeps selected past immutable while live captures continue; returning live has no commands',()=>{
+  const replay=new ShortReplay();
+  const poses=[{agentId:'main',runId:'qa-1',x:1390,y:1710,world:[14.02,9.6,13.18] as [number,number,number],state:'standing'}];
+  replay.capture(1000,poses,[]);replay.capture(2000,[{...poses[0],x:1400}],[]);
+  replay.select(0);const selected=replay.getView().selected;
+  poses[0].world[0]=999;replay.capture(3000,[{...poses[0],x:1500}],[]);
+  expect(replay.getView().selected).toBe(selected);expect(selected?.poses[0].world[0]).toBe(14.02);
+  expect(replay.getView().live?.poses[0].x).toBe(1500);
+  replay.select(null);expect(replay.getView().selected).toBeNull();
+ });
+ it('bounds age/count/rate and rejects invalid or backwards-clock captures',()=>{
+  const replay=new ShortReplay();
+  for(let n=0;n<300;n++)replay.capture(n*1000,[],[]);
+  expect(replay.getView().frames).toHaveLength(180);
+  const before=replay.getView().live;expect(replay.capture(299500,[],[])).toBe(false);
+  expect(replay.capture(2000,[],[])).toBe(false);expect(replay.getView().live).toBe(before);
+  replay.select(0);replay.capture(600000,[],[]);
+  expect(replay.getView().frames).toHaveLength(1);expect(replay.getView().selected).toBeNull();
+  expect(replay.capture(NaN,[],[])).toBe(false);
+  expect(replay.capture(601000,[{agentId:'main',runId:'a',x:0,y:0,world:[0,Infinity,0],state:'standing'}],[])).toBe(false);
+ });
+});
