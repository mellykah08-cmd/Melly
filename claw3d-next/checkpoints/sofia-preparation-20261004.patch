diff --git a/claw3d-next/dev-qa-telemetry.cjs b/claw3d-next/dev-qa-telemetry.cjs
new file mode 100644
index 0000000..91745a3
--- /dev/null
+++ b/claw3d-next/dev-qa-telemetry.cjs
@@ -0,0 +1,15 @@
+'use strict';
+// Caller obtains these facts from trusted execution metadata, not request text.
+// This pure adapter never fetches or sends. Runtime wiring remains separate.
+function makeQaTelemetry(proof){
+ if(!proof||proof.workflowId!=='ao8OMQEpoaGbORGE'||proof.manual!==true||proof.inactive!==true||
+    proof.externalCalls!==0||proof.realMessages!==0||typeof proof.qaPassed!=='boolean'||
+    typeof proof.executionId!=='string'||!/^\d{1,20}$/.test(proof.executionId))throw Error('Isolated DEV proof required');
+ const runId='qa-'+proof.executionId;
+ const base={source:'n8n',floorId:'dev-third',agentId:'main',runId,stationId:'qa_station_1'};
+ return [
+  Object.freeze({...base,id:runId+'-1',sequence:1,status:'workflow.running',progress:0}),
+  Object.freeze({...base,id:runId+'-2',sequence:2,status:proof.qaPassed?'workflow.completed':'workflow.failed',progress:100}),
+ ];
+}
+module.exports={makeQaTelemetry};
diff --git a/claw3d-next/patch-third-floor.cjs b/claw3d-next/patch-third-floor.cjs
new file mode 100644
index 0000000..9d0f745
--- /dev/null
+++ b/claw3d-next/patch-third-floor.cjs
@@ -0,0 +1,24 @@
+'use strict';
+const fs=require('node:fs'),path=require('node:path');
+if(process.env.SOFIA_THIRD_FLOOR_EXPANSION!=='1'){console.log('SOFIA_THIRD_FLOOR_EXPANSION: disabled');process.exit(0)}
+const marker='SOFIA_THIRD_FLOOR_EXPANSION';
+const sceneFile='src/features/retro-office/RetroOffice3D.tsx';
+const files=['ThirdFloorDirector.ts','ThirdFloorRoute.ts','ThirdFloorStations.ts','MonitorCanvas.ts','NpcMonitorTexture.tsx','ThirdFloorWorkstations.tsx','ShortReplay.ts'];
+let scene=fs.readFileSync(sceneFile,'utf8');
+if(!scene.includes('synchronizeThirdFloorRoute')||!scene.includes('thirdFloorDirector.arrived('))throw Error(marker+': verified Phase 2 route/arrival baseline missing');
+// Resolve all anchors and sources before writing anything. This installer
+// assumes the verified Phase 2 baseline is already present; it changes no auth.
+for(const file of files)fs.accessSync(path.join(__dirname,file),fs.constants.R_OK);
+if(!scene.includes('// '+marker)){
+ const change=(anchor,replacement)=>{
+  if(scene.split(anchor).length!==2)throw Error(marker+': missing/ambiguous anchor');
+  scene=scene.replace(anchor,replacement);
+ };
+ change('"use client";','"use client";\n// '+marker+'\nimport {ThirdFloorWorkstations} from "@/features/sofia-ops/ThirdFloorWorkstations";');
+ const anchor='{/* Game loop — no React state, pure ref mutations. */}';
+ change(anchor,'{sofiaCampusMode && <ThirdFloorWorkstations />}\n            '+anchor);
+}
+const destination='src/features/sofia-ops';fs.mkdirSync(destination,{recursive:true});
+for(const file of files)fs.copyFileSync(path.join(__dirname,file),path.join(destination,file));
+fs.writeFileSync(sceneFile,scene);
+console.log(marker+': canonical files installed, single candidate monitor; multi-target routing not activated');
