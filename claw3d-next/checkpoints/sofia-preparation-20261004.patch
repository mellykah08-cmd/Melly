+bridge.authenticate(socket,{type:'hello-ok',auth:{role:'operator',scopes:['operator.read']}});
+function post(runId, sequence, status, extra={}) {
+ const req=new EventEmitter(); Object.assign(req,{method:'POST',url:'/api/sofia-ops/events/third-floor',headers:{authorization:'Bearer synthetic-test-only','content-type':'application/json'},resume(){}});
+ const res={writeHead(code){this.code=code},end(raw){this.body=JSON.parse(raw)}};
