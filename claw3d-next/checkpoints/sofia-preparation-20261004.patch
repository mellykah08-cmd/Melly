+  for(const [status,rgb] of [['workflow.running',[56,189,248]],['workflow.completed',[74,222,128]],['workflow.failed',[251,113,133]]] as const){
+   m.update(event(status));vi.advanceTimersByTime(500);
+   expect([...canvas.getContext('2d').getImageData(40,49,1,1).data].slice(0,3)).toEqual(rgb);
+  }
+  m.update(null);vi.advanceTimersByTime(500);expect(vi.getTimerCount()).toBe(0);
+  expect(canvas.width).toBe(512);expect(canvas.height).toBe(256);
+  m.dispose();expect(vi.getTimerCount()).toBe(0);
+ });
+ it('coalesces updates at 2Hz, latest data survives throttle and disposal stops timers',()=>{
+  vi.useFakeTimers();const canvas=createCanvas(512,256);const m=createMonitorCanvas(canvas,()=>{});
+  m.update(event('workflow.running')); const version=m.texture!.version;
+  m.update({...event('workflow.running'),sequence:2});m.update({...event('workflow.completed'),sequence:3});
+  expect(m.texture!.version).toBe(version);vi.advanceTimersByTime(500);
+  expect(m.texture!.version).toBe(version+1);expect(vi.getTimerCount()).toBe(0);
+  expect([...canvas.getContext('2d').getImageData(40,49,1,1).data].slice(0,3)).toEqual([74,222,128]);
+  m.update(event('workflow.running'));m.dispose();vi.advanceTimersByTime(1000);
+  expect(vi.getTimerCount()).toBe(0);
+ });
+});
