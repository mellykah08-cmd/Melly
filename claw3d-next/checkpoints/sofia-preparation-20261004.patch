+"use client";
+import {memo,useEffect,useRef,useState} from 'react';
+import {useThree} from '@react-three/fiber';
+import type {CanvasTexture} from 'three';
+import {useThirdFloorDirector} from './ThirdFloorDirector';
+import {createMonitorCanvas} from './MonitorCanvas';
+export const NpcMonitorScreen=memo(function NpcMonitorScreen({stationId}:{stationId:string}) {
+ const states=useThirdFloorDirector();
+ const event=Object.values(states).find(e=>(e.stationId??'qa_station_1')===stationId)??null;
+ const invalidate=useThree(s=>s.invalidate);
+ const resource=useRef<ReturnType<typeof createMonitorCanvas>|null>(null);
+ const [texture,setTexture]=useState<CanvasTexture|null>(null);
+ useEffect(()=>{
+  const monitor=createMonitorCanvas(document.createElement('canvas'),invalidate);
+  resource.current=monitor;setTexture(monitor.texture);
+  return ()=>{resource.current=null;monitor.dispose()};
+ },[invalidate]);
+ useEffect(()=>{resource.current?.update(event)},[event,texture]);
+ if(!texture)return null;
+ return <group>
+  <mesh><boxGeometry args={[0.58,0.34,0.05]}/><meshBasicMaterial color="#1e293b"/></mesh>
+  <mesh position={[0,0,0.027]}><planeGeometry args={[0.54,0.30]}/><meshBasicMaterial map={texture} toneMapped={false}/></mesh>
+ </group>;
+});
