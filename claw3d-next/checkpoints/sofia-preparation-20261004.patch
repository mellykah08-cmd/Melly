+import {describe,it,expect} from 'vitest';
+import {reduceWorld,type WorldEvent} from '@/lib/sofia-ops/worldState';
+const ts=1800000000000;
+const e=(id:string,type:string,extra:Partial<WorldEvent>={}):WorldEvent=>({id,type,ts,source:'railway',severity:'info',summary:id,project:'sofia',...extra});
+describe('causal evidence isolation',()=>{
+ it('War Room excludes another correlation/project recovery and critical evidence',()=>{
+  const events=[e('incident-a','incident.opened',{correlationId:'a',severity:'critical'}),e('other','incident.resolved',{ts:ts+1,source:'n8n',project:'other',correlationId:'b',severity:'success'}),e('other-critical','workflow.failed',{ts:ts+2,source:'n8n',project:'other',correlationId:'b',severity:'critical'})];
+  const world=reduceWorld(events,[{id:'main',status:'idle'}],ts+100);
+  expect(world.incident?.timeline.map(x=>x.id)).toEqual(['incident-a']);
+  expect(world.incident?.evidence).toEqual(['incident-a']);
+ });
+ it('a correlated Shadow comparison cannot borrow an uncorrelated human/candidate',()=>{
+  const events=[e('candidate','shadow.candidate'),e('human','shadow.human',{ts:ts+1}),e('compare','shadow.compare',{ts:ts+2,correlationId:'specific',payloadText:'{"score":0.9,"match":true}'})];
+  const shadow=reduceWorld(events,[],ts+100).shadow;
+  expect(shadow.compare?.id).toBe('compare');expect(shadow.candidate).toBeNull();expect(shadow.human).toBeNull();
+ });
+});
