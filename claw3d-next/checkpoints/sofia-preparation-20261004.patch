new file mode 100644
index 0000000..10f8301
--- /dev/null
+++ b/claw3d-next/ThirdFloorStations.ts
@@ -0,0 +1,26 @@
+import {toWorld} from '@/features/retro-office/core/geometry';
+export type StationTarget={stationId:string;x:number;y:number;facing:number;pose:'stand';floorId:'dev-third'};
+// Proposed layout on the existing south corridor. Geometry/Android acceptance
+// remains required; these leases do not move avatars until explicitly wired.
+const positions:[string,number][]=[
+ ['qa_station_1',1390],['qa_station_2',1470],['devops_desk',1310],['war_room',1230],['shadow_desk',1550],
+];
+export const THIRD_FLOOR_STATIONS:Readonly<Record<string,StationTarget>>=Object.freeze(Object.fromEntries(positions.map(([stationId,x])=>[stationId,Object.freeze({stationId,x,y:1710,facing:0,pose:'stand' as const,floorId:'dev-third' as const})])));
+export function stationWorld(x:number,y:number,heightOffset=0):[number,number,number] {
+ const [wx,,wz]=toWorld(x,y);return [wx+5.2,9.6+heightOffset,wz-1.4];
+}
+export class StationAllocator {
+ private leases=new Map<string,{agentId:string;runId:string}>();
+ claim(agentId:string,runId:string,stationId:string):StationTarget|null {
+  const station=THIRD_FLOOR_STATIONS[stationId];if(!station)return null;
+  const occupant=this.leases.get(stationId);
+  if(occupant && (occupant.agentId!==agentId || occupant.runId!==runId))return null;
+  // One station per agent. Reusing an occupied station requires release;
+  // stale terminal events can never release another run's lease.
+  for(const [key,lease] of this.leases)if(lease.agentId===agentId && key!==stationId)this.leases.delete(key);
+  this.leases.set(stationId,{agentId,runId});return station;
+ }
+ release(agentId:string,runId:string) {
+  for(const [key,lease] of this.leases)if(lease.agentId===agentId&&lease.runId===runId)this.leases.delete(key);
+ }
+}
