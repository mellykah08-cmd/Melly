+      window.dispatchEvent(new Event("load")); vi.advanceTimersByTime(1000);
+      expect(document.body.textContent).not.toContain("Chegada confirmada");
+      canvas.dataset.sofiaMain = JSON.stringify({ ...raw, state: "standing" });
+      vi.advanceTimersByTime(1000);
+      expect(document.body.textContent).toContain("Chegada confirmada");
+      const reports = send.mock.calls.map(call => JSON.parse(JSON.parse((call as any)[1].body).message));
