+assert.equal(post('a',3,'workflow.step',{progress:80,stationId:'qa_station_2'}).body.accepted,true);
+assert.equal(frames.at(-1).stationId,'qa_station_1');
+assert.equal(post('a',4,'workflow.completed',{durationMs:1234}).body.accepted,true);
+for(const status of ['workflow.running','workflow.log','workflow.step','workflow.failed','workflow.completed']) assert.equal(post('a',10,status).body.accepted,false);
+assert.equal(post('b',1,'workflow.running').body.accepted,true);
+assert.equal(post('a',11,'workflow.failed').body.accepted,false);
+assert.equal(post('old',2,'workflow.step').body.accepted,false);
