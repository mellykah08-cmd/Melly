+import type {ThirdFloorEvent} from './ThirdFloorDirector';
+export type ObservedPose={agentId:string;runId:string;x:number;y:number;world:[number,number,number];state:string};
+export type ReplayFrame={readonly at:number;readonly poses:readonly Readonly<ObservedPose>[];readonly events:readonly ThirdFloorEvent[]};
+// Preparation contract: monotonic client milliseconds, at most 1 sample/second,
+// at most 180 samples and 180 seconds of RAM. No RPC, persistence or live mutation.
+// A producer must supply actual physical poses; transport events cannot infer them.
+export class ShortReplay {
+ private frames:ReplayFrame[]=[];
+ private selected:ReplayFrame|null=null;
+ capture(at:number,poses:ObservedPose[],events:ThirdFloorEvent[]):boolean {
+  const previous=this.frames.at(-1);
+  if(!Number.isFinite(at)||at<0||(previous&&at-previous.at<1000))return false;
+  if(poses.some(p=>![p.x,p.y,...p.world].every(Number.isFinite)))return false;
+  const safePoses=poses.slice(0,100).map(p=>Object.freeze({
+   agentId:p.agentId,runId:p.runId,x:p.x,y:p.y,
+   world:Object.freeze([...p.world]) as unknown as [number,number,number],state:p.state,
+  }));
+  const safeEvents=events.slice(0,100).map(e=>Object.freeze({
+   id:e.id,source:e.source,floorId:e.floorId,agentId:e.agentId,runId:e.runId,sequence:e.sequence,status:e.status,
+   ...(e.stationId?{stationId:e.stationId}:{}),...(e.progress!==undefined?{progress:e.progress}:{}),
+  }));
+  const frame=Object.freeze({at,poses:Object.freeze(safePoses),events:Object.freeze(safeEvents)});
+  this.frames=this.frames.filter(f=>at-f.at<180000).concat(frame).slice(-180);
+  if(this.selected&&!this.frames.includes(this.selected))this.selected=null;
+  return true;
+ }
+ select(index:number|null):void {
+  this.selected=index===null||!Number.isInteger(index)||index<0||index>=this.frames.length-1?null:this.frames[index];
+ }
+ getView(){return Object.freeze({frames:Object.freeze([...this.frames]),selected:this.selected,live:this.frames.at(-1)??null})}
+ clear(){this.frames=[];this.selected=null}
+}
