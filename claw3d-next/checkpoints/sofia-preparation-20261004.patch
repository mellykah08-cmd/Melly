+import {CanvasTexture,LinearFilter,NearestFilter,SRGBColorSpace} from 'three';
+import type {ThirdFloorEvent} from './ThirdFloorDirector';
+export const WORKFLOW_COLORS={ 'workflow.running':'#38bdf8','workflow.completed':'#4ade80','workflow.failed':'#fb7185'} as const;
+export function createMonitorCanvas(canvas:HTMLCanvasElement,invalidate:()=>void) {
+ canvas.width=512;canvas.height=256;
+ const context=canvas.getContext('2d',{alpha:false});
+ if(!context)throw Error('Canvas 2D unavailable');
+ const ctx=context;
+ const texture=new CanvasTexture(canvas);texture.generateMipmaps=false;
+ texture.minFilter=LinearFilter;texture.magFilter=NearestFilter;texture.colorSpace=SRGBColorSpace;
+ let event:ThirdFloorEvent|null=null, timer:ReturnType<typeof setTimeout>|undefined;
+ let lastPaint=-Infinity, signature='', blink=false, disposed=false;
+ const schedule=()=>{
+  if(timer!==undefined||disposed)return;
+  timer=setTimeout(()=>{timer=undefined;blink=!blink;paint()},Math.max(0,500-(Date.now()-lastPaint)));
+ };
+ const paint=()=>{
+  if(disposed)return;
+  const now=Date.now();if(now-lastPaint<500){schedule();return;}
+  const active=event?.status==='workflow.running';
+  const key=JSON.stringify([event,active&&blink]);
+  if(key!==signature){
+   signature=key;lastPaint=now;
+   ctx.fillStyle='#0c1017';ctx.fillRect(0,0,512,256);
+   if(event){
+    const color=WORKFLOW_COLORS[event.status];
+    ctx.fillStyle=color;ctx.font='bold 18px monospace';ctx.fillText(event.status.replace('workflow.','').toUpperCase(),20,30);
+    ctx.fillStyle='#1e293b';ctx.fillRect(20,44,472,10);
+    ctx.fillStyle=color;ctx.fillRect(20,44,472*(event.progress??(event.status==='workflow.completed'?100:0))/100,10);
+    ctx.fillStyle='#e2e8f0';ctx.font='14px monospace';
+    for(const [index,line] of (event.recentLogs??[]).slice(-5).entries())ctx.fillText('> '+line.slice(0,52),20,85+index*24);
+    if(active&&blink){ctx.fillStyle=color;ctx.fillRect(20,212,8,12);}
+    ctx.fillStyle='#94a3b8';ctx.font='11px monospace';ctx.fillText(`${event.agentId} | seq ${event.sequence} | ${event.durationMs===undefined?'DEV':event.durationMs+'ms'}`,20,242);
+   }else{
+    ctx.fillStyle='#94a3b8';ctx.font='16px monospace';ctx.fillText('STANDBY',20,40);ctx.fillText('AGUARDANDO TELEMETRIA DEV',20,80);
+   }
+   texture.needsUpdate=true;invalidate();
+  }
+  if(active)schedule();
+ };
+ return {texture,update(next:ThirdFloorEvent|null){if(disposed)return;event=next;paint();},dispose(){disposed=true;if(timer!==undefined)clearTimeout(timer);timer=undefined;texture.dispose();}};
+}
