+  type: "event", event: "sofia.ops", payload: {
+    id: `${runId}-${sequence}`, source: "n8n", floorId: "dev-third",
+    agentId: "main", runId, sequence, status,
+  },
+});
+
+describe("contract audit: separate workflow and OpenClaw states", () => {
+  it("releases the arrived completed workflow after 30s while the independent OpenClaw label stays working", async () => {
+    vi.useFakeTimers(); vi.resetModules(); vi.setSystemTime(1800000000000);
+    const { thirdFloorDirector: d } = await import("@/features/sofia-ops/ThirdFloorDirector");
+    d.ingest(event("workflow.running", 1));
+    d.ingest(event("workflow.completed", 2));
+    vi.advanceTimersByTime(45000);
+    expect(d.getSnapshot().main.status).toBe("workflow.completed");
+    const agents = [{ id: "main", status: "running" }];
+    expect(STATE_LABEL[reduceWorld([], agents, Date.now()).agents.main.state]).toBe("trabalhando");
+    d.arrived("main"); vi.advanceTimersByTime(29999);
+    expect(d.getSnapshot().main.status).toBe("workflow.completed");
+    vi.advanceTimersByTime(1);
+    expect(d.getSnapshot().main).toBeUndefined();
+    expect(STATE_LABEL[reduceWorld([], agents, Date.now()).agents.main.state]).toBe("trabalhando");
+  });
+
+  it("preserves a real run over preview and rejects late terminal/log/step/running updates", async () => {
+    vi.useFakeTimers(); vi.resetModules();
+    const { thirdFloorDirector: d } = await import("@/features/sofia-ops/ThirdFloorDirector");
+    d.preview("workflow.failed"); d.ingest(event("workflow.running", 1));
+    expect(d.getSnapshot().main.runId).toBe("audit-run");
