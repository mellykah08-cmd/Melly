+import {describe,it,expect} from 'vitest';
+import {planThirdFloorRoute,SECOND_RAMP_END,FIRST_RAMP_END} from '@/features/sofia-ops/ThirdFloorRoute';
+import {StationAllocator,stationWorld} from '@/features/sofia-ops/ThirdFloorStations';
+describe('explicit third-floor destinations',()=>{
+ it('extra station ascends both ramps and walks on floor 3; returns via landing',()=>{
+  const route=planThirdFloorRoute({x:800,y:420},{x:1470,y:1710,floorId:'dev-third'},[],[],[]);
+  expect(route).toContainEqual(FIRST_RAMP_END);expect(route).toContainEqual(SECOND_RAMP_END);
+  expect(route.at(-1)).toMatchObject({x:1470,y:1710,sofiaWorld:[expect.closeTo(15.46,6),9.6,expect.closeTo(13.18,6)]});
+  const back=planThirdFloorRoute({x:1470,y:1710,sofiaWorldPosition:[15.46,9.6,13.18]},{x:800,y:420},[],[],[]);
+  expect(back).toContainEqual(SECOND_RAMP_END);
+  expect(back.findIndex(p=>p.y===1710&&p.x===1390)).toBeLessThan(back.findIndex(p=>p.y===1480));
+ });
+ it('rejects a station in the ramp or blocked by furniture instead of teleporting',()=>{
+  expect(planThirdFloorRoute({x:800,y:420},{x:1470,y:1640,floorId:'dev-third'},[],[],[])).toEqual([]);
+  expect(planThirdFloorRoute({x:800,y:420},{x:1470,y:1710,floorId:'dev-third'},[],[],[{_uid:'blocked',type:'wall',x:1460,y:1700,w:50,h:50}])).toEqual([]);
+ });
+ it('leases distinct stations, refuses occupancy, releases only matching run',()=>{
+  const pool=new StationAllocator();
+  expect(pool.claim('main','a','qa_station_1')?.stationId).toBe('qa_station_1');
+  expect(pool.claim('n8n-reviewer','b','qa_station_1')).toBeNull();
+  expect(pool.claim('n8n-reviewer','b','qa_station_2')?.x).toBe(1470);
+  pool.release('main','old');expect(pool.claim('supervisor','c','qa_station_1')).toBeNull();
+  pool.release('main','a');expect(pool.claim('supervisor','c','qa_station_1')?.stationId).toBe('qa_station_1');
+  expect(stationWorld(1390,1710)).toEqual([expect.closeTo(14.02,6),9.6,expect.closeTo(13.18,6)]);
+ });
+});
